{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01YCuwD6PNcr7W85VtcVxNRJ","type":"tool_result","content":"     1→\"use client\";\n     2→\n     3→import { useState, useEffect, useCallback } from \"react\";\n     4→import { useRouter } from \"next/navigation\";\n     5→import { useForm } from \"react-hook-form\";\n     6→import { zodResolver } from \"@hookform/resolvers/zod\";\n     7→import { z } from \"zod\";\n     8→import { useLocale, useTranslations } from \"next-intl\";\n     9→import { CheckCircle, XCircle, Loader2 } from \"lucide-react\";\n    10→\n    11→import { Button } from \"@/components/ui/button\";\n    12→import { Input } from \"@/components/ui/input\";\n    13→import {\n    14→  Form,\n    15→  FormControl,\n    16→  FormDescription,\n    17→  FormField,\n    18→  FormItem,\n    19→  FormLabel,\n    20→  FormMessage,\n    21→} from \"@/components/ui/form\";\n    22→import { cn } from \"@/lib/utils\";\n    23→import { supabase } from \"@/lib/supabase\";\n    24→\n    25→const createUsernameSchema = (t: ReturnType<typeof useTranslations<\"completeProfile\">>) =>\n    26→  z.object({\n    27→    username: z\n    28→      .string()\n    29→      .min(1, t(\"errors.usernameRequired\"))\n    30→      .min(2, t(\"errors.usernameMinLength\"))\n    31→      .max(100, t(\"errors.usernameMaxLength\")),\n    32→  });\n    33→\n    34→type UsernameFormValues = z.infer<ReturnType<typeof createUsernameSchema>>;\n    35→\n    36→type UsernameStatus = \"idle\" | \"checking\" | \"available\" | \"taken\";\n    37→\n    38→export function CompleteProfileContent() {\n    39→  const t = useTranslations(\"completeProfile\");\n    40→  const locale = useLocale();\n    41→  const router = useRouter();\n    42→  const [isSubmitting, setIsSubmitting] = useState(false);\n    43→  const [submitError, setSubmitError] = useState<string | null>(null);\n    44→  const [usernameStatus, setUsernameStatus] = useState<UsernameStatus>(\"idle\");\n    45→  const [isLoading, setIsLoading] = useState(true);\n    46→  const [userEmail, setUserEmail] = useState<string | null>(null);\n    47→\n    48→  const schema = createUsernameSchema(t);\n    49→\n    50→  const form = useForm<UsernameFormValues>({\n    51→    resolver: zodResolver(schema),\n    52→    defaultValues: {\n    53→      username: \"\",\n    54→    },\n    55→    mode: \"onChange\",\n    56→  });\n    57→\n    58→  const usernameValue = form.watch(\"username\");\n    59→\n    60→  // Check if user is authenticated and needs to set username\n    61→  useEffect(() => {\n    62→    const checkAuth = async () => {\n    63→      const { data: { user } } = await supabase.auth.getUser();\n    64→\n    65→      if (!user) {\n    66→        // Not authenticated, redirect to login\n    67→        router.push(`/${locale}/login`);\n    68→        return;\n    69→      }\n    70→\n    71→      // Check if user already has a profile with username\n    72→      const { data: profile } = await supabase\n    73→        .from(\"profiles\")\n    74→        .select(\"full_name\")\n    75→        .eq(\"id\", user.id)\n    76→        .maybeSingle();\n    77→\n    78→      if (profile?.full_name) {\n    79→        // User already has a username, redirect to home\n    80→        router.push(`/${locale}`);\n    81→        return;\n    82→      }\n    83→\n    84→      setUserEmail(user.email || null);\n    85→      setIsLoading(false);\n    86→    };\n    87→\n    88→    checkAuth();\n    89→  }, [locale, router]);\n    90→\n    91→  const checkUsernameAvailability = useCallback(\n    92→    async (username: string) => {\n    93→      if (!username || username.length < 2) {\n    94→        setUsernameStatus(\"idle\");\n    95→        return;\n    96→      }\n    97→\n    98→      setUsernameStatus(\"checking\");\n    99→\n   100→      try {\n   101→        const { data, error } = await supabase\n   102→          .from(\"profiles\")\n   103→          .select(\"full_name\")\n   104→        