→            <Link\n    43→              key={item.key}\n    44→              href={`/${locale}${item.href}`}\n    45→              className=\"text-sm font-medium text-muted-foreground transition-colors hover:text-foreground\"\n    46→            >\n    47→              {t(item.key)}\n    48→            </Link>\n    49→          ))}\n    50→        </nav>\n    51→\n    52→        {/* Desktop Right Section */}\n    53→        <div className=\"hidden md:flex items-center gap-4\">\n    54→          <LanguageSwitcher />\n    55→\n    56→          {/* Auth Status */}\n    57→          {isAuthenticated ? (\n    58→            <Link\n    59→              href={`/${locale}/profile`}\n    60→              className=\"flex items-center gap-2 text-sm font-medium text-muted-foreground transition-colors hover:text-foreground\"\n    61→            >\n    62→              <User className=\"h-4 w-4\" />\n    63→              {tAuth(\"profile\")}\n    64→            </Link>\n    65→          ) : (\n    66→            <div className=\"flex items-center gap-2\">\n    67→              <Link\n    68→                href={`/${locale}/login`}\n    69→                className=\"flex items-center gap-2 text-sm font-medium text-muted-foreground transition-colors hover:text-foreground\"\n    70→              >\n    71→                <LogIn className=\"h-4 w-4\" />\n    72→                {tAuth(\"login\")}\n    73→              </Link>\n    74→              <Link\n    75→                href={`/${locale}/register`}\n    76→                className=\"flex items-center gap-2 rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground transition-colors hover:bg-primary/90\"\n    77→              >\n    78→                {tAuth(\"register\")}\n    79→              </Link>\n    80→            </div>\n    81→          )}\n    82→        </div>\n    83→\n    84→        {/* Mobile Menu Button */}\n    85→        <button\n    86→          type=\"button\"\n    87→          className=\"md:hidden p-2 text-muted-foreground hover:text-foreground\"\n    88→          onClick={() => setMobileMenuOpen(!mobileMenuOpen)}\n    89→          aria-label={mobileMenuOpen ? t(\"closeMenu\") : t(\"menu\")}\n    90→          aria-expanded={mobileMenuOpen}\n    91→        >\n    92→          {mobileMenuOpen ? (\n    93→            <X className=\"h-6 w-6\" />\n    94→          ) : (\n    95→            <Menu className=\"h-6 w-6\" />\n    96→          )}\n    97→        </button>\n    98→      </div>\n    99→\n   100→      {/* Mobile Menu */}\n   101→      <div\n   102→        className={cn(\n   103→          \"md:hidden overflow-hidden transition-all duration-300 ease-in-out\",\n   104→          mobileMenuOpen ? \"max-h-[500px] border-t border-border/40\" : \"max-h-0\"\n   105→        )}\n   106→      >\n   107→        <nav className=\"container mx-auto px-4 py-4 space-y-4\">\n   108→          {navItems.map((item) => (\n   109→            <Link\n   110→              key={item.key}\n   111→              href={`/${locale}${item.href}`}\n   112→              className=\"block text-base font-medium text-muted-foreground transition-colors hover:text-foreground\"\n   113→              onClick={() => setMobileMenuOpen(false)}\n   114→            >\n   115→              {t(item.key)}\n   116→            </Link>\n   117→          ))}\n   118→\n   119→          <div className=\"pt-4 border-t border-border/40 space-y-4\">\n   120→            <div className=\"flex items-center justify-between\">\n   121→              <span className=\"text-sm text-muted-foreground\">\n   122→                {t(\"home\")}\n   123→              </span>\n   124→              <LanguageSwitcher />\n   125→            </div>\n   126→\n   127→            {/* Mobile Auth */}\n   128→            {isAuthenticated ? (\n   129→              <Link\n   130→                href={`/${locale}/profile`}\n   131→                className=\"flex items-center gap-2 text-base font-medium text-muted-foreground transition-colors hover:text-foreground\"\n   132→                onClick={() => setMobileMenuOpen(false)}\n   133→              >\n   134→                <User className=\"h-5 w-5\" />\n   135→                {tAuth(\"profile\")}\n   136→              </Link>\n   137→            ) : (\n   138→              <div className=\"flex flex-col gap-3\">\n   139→                <Link\n   140→                  href={`/${locale}/login`}\n   141→                  className=\"flex items-center justify-center gap-2 rounded-md border border-border px-4 py-2.5 text-base font-medium text-foreground transition-colors hover:bg-accent\"\n   142→                  onClick={() => setMobileMenuOpen(false)}\n   143→                >\n   144→                  <LogIn className=\"h-5 w-5\" />\n   145→                  {tAuth(\"login\")}\n   146→                </Link>\n   147→                <Link\n   148→                  href={`/${locale}/register`}\n   149→                  className=\"flex items-center justify-center gap-2 rounded-md bg-primary px-4 py-2.5 text-base font-medium text-primary-foreground transition-colors hover:bg-primary/90\"\n   150→                  onClick={() => setMobileMenuOpen(false)}\n   151→                >\n   152→                  {tAuth(\"register\")}\n   153→                </Link>\n   154→              </div>\n   155→            )}\n   156→          </div>\n   157→        </nav>\n   158→      </div>\n   159→    </header>\n   160→  );\n   161→}\n   162→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"48c5a601-5c0d-4020-9400-055b75cedacf","uuid":"ed0dbe12-57b9-45bb-96dc-a11d0334450d","tool_use_result":{"type":"text","file":{"filePath":"/Users/anayusta/workspace/roundnet/src/components/header.tsx","content":"\"use client\";\n\nimport { useState } from \"react\";\nimport Link from \"next/link\";\nimport { useLocale, useTranslations } from \"next-intl\";\nimport { Menu, X, User, LogIn } from \"lucide-react\";\nimport { LanguageSwitcher } from \"./language-switcher\";\nimport { cn } from \"@/lib/utils\";\n\nconst navItems = [\n  { key: \"educational\", href: \"/educational\" },\n  { key: \"tournaments\", href: \"/tournaments\" },\n  { key: \"training\", href: \"/training\" },\n  { key: \"rankings\", href: \"/rankings\" },\n  { key: \"bulkOrders\", href: \"/bulk-orders\" },\n] as const;\n\nexport function Header() {\n  const t = useTranslations(\"nav\");\n  const tAuth = useTranslations(\"auth\");\n  const locale = useLocale();\n  const [mobileMenuOpen, setMobileMenuOpen] = useState(false);\n\n  // TODO: Replace with actual auth state from Supabase\n  const isAuthenticated = false;\n\n  return (\n    <header className=\"sticky top-0 z-50 w-full border-b border-border/40 bg-background/95 backdrop-blur supports-[backdrop-filter]:bg-background/60\">\n      <div className=\"container mx-auto flex h-16 items-center justify-between px-4\">\n        {/* Logo */}\n        <Link\n          href={`/${locale}`}\n          className=\"flex items-center gap-2 font-semibold text-lg\"\n        >\n          <span className=\"text-primary\">Roundnet</span>\n          <span className=\"text-muted-foreground\">Spain</span>\n        </Link>\n\n        {/* Desktop Navigation */}\n        <nav className=\"hidden md:flex items-center gap-6\">\n          {navItems.map((item) => (\n            <Link\n              key={item.key}\n              href={`/${locale}${item.href}`}\n              className=\"text-sm font-medium text-muted-foreground transition-colors hover:text-foreground\"\n            >\n              {t(item.key)}\n            </Link>\n          ))}\n        </nav>\n\n        {/* Desktop Right Section */}\n        <div className=\"hidden md:flex items-center gap-4\">\n          <LanguageSwitcher />\n\n          {/* Auth Status */}\n          {isAuthenticated ? (\n            <Link\n              href={`/${locale}/profile`}\n              className=\"flex items-center gap-2 text-sm font-medium text-muted-foreground transition-colors hover:text-foreground\"\n            >\n              <User className=\"h-4 w-4\" />\n              {tAuth(\"profile\")}\n            </Link>\n          ) : (\n            <div className=\"flex items-center gap-2\">\n              <Link\n                href={`/${locale}/login`}\n                className=\"flex items-center gap-2 text-sm font-medium text-muted-foreground transition-colors hover:text-foreground\"\n              >\n                <LogIn className=\"h-4 w-4\" />\n                {tAuth(\"login\")}\n              </Link>\n              <Link\n                href={`/${locale}/register`}\n                className=\"flex items-center gap-2 rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground transition-colors hover:bg-primary/90\"\n              >\n                {tAuth(\"register\")}\n              </Link>\n            </div>\n          )}\n        </div>\n\n        {/* Mobile Menu Button */}\n        <button\n          type=\"button\"\n          className=\"md:hidden p-2 text-muted-foreground hover:text-foreground\"\n          onClick={() => setMobileMenuOpen(!mobileMenuOpen)}\n          aria-label={mobileMenuOpen ? t(\"closeMenu\") : t(\"menu\")}\n          aria-expanded={mobileMenuOpen}\n        >\n          {mobileMenuOpen ? (\n            <X className=\"h-6 w-6\" />\n          ) : (\n            <Menu className=\"h-6 w-6\" />\n          )}\n        </button>\n      </div>\n\n      {/* Mobile Menu */}\n      <div\n        className={cn(\n          \"md:hidden overflow-hidden transition-all duration-300 ease-in-out\",\n          mobileMenuOpen ? \"max-h-[500px] border-t border-border/40\" : \"max-h-0\"\n        )}\n      >\n        <nav className=\"container mx-auto px-4 py-4 space-y-4\">\n          {navItems.map((item) => (\n            <Link\n              key={item.key}\n              href={`/${locale}${item.href}`}\n              className=\"block text-base font-medium text-muted-foreground transition-colors hover:text-foreground\"\n              onClick={() => setMobileMenuOpen(false)}\n            >\n              {t(item.key)}\n            </Link>\n          ))}\n\n          <div className=\"pt-4 border-t border-border/40 space-y-4\">\n            <div className=\"flex items-center justify-between\">\n              <span className=\"text-sm text-muted-foreground\">\n                {t(\"home\")}\n              </span>\n              <LanguageSwitcher />\n            </div>\n\n            {/* Mobile Auth */}\n            {isAuthenticated ? (\n              <Link\n                href={`/${locale}/profile`}\n                className=\"flex items-center gap-2 text-base font-medium text-muted-foreground transition-colors hover:text-foreground\"\n                onClick={() => setMobileMenuOpen(false)}\n              >\n                <User className=\"h-5 w-5\" />\n                {tAuth(\"profile\")}\n              </Link>\n            ) : (\n              <div className=\"flex flex-col gap-3\">\n                <Link\n                  href={`/${locale}/login`}\n                  className=\"flex items-center justify-center gap-2 rounded-md border border-border px-4 py-2.5 text-base font-medium text-foreground transition-colors hover:bg-accent\"\n                  onClick={() => setMobileMenuOpen(false)}\n                >\n                  <LogIn className=\"h-5 w-5\" />\n                  {tAuth(\"login\")}\n                </Link>\n                <Link\n                  href={`/${locale}/register`}\n                  className=\"flex items-center justify-center gap-2 rounded-md bg-primary px-4 py-2.5 text-base font-medium text-primary-foreground transition-colors hover:bg-primary/90\"\n                  onClick={() => setMobileMenuOpen(false)}\n                >\n                  {tAuth(\"register\")}\n                </Link>\n              </div>\n            )}\n          </div>\n        </nav>\n      </div>\n    </header>\n  );\n}\n","numLines":162,"startLine":1,"totalLines":162}}}
