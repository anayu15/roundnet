 50→      identifier: \"\",\n    51→      password: \"\",\n    52→    },\n    53→    mode: \"onChange\",\n    54→  });\n    55→\n    56→  const onSubmit = async (values: LoginFormValues) => {\n    57→    setIsSubmitting(true);\n    58→    setSubmitError(null);\n    59→    setSubmitSuccess(null);\n    60→\n    61→    try {\n    62→      let email = values.identifier;\n    63→\n    64→      // Check if the identifier is an email or username\n    65→      if (!isEmail(values.identifier)) {\n    66→        // It's a username - need to look up the email\n    67→        const { data: profileData, error: profileError } = await supabase\n    68→          .from(\"profiles\")\n    69→          .select(\"id\")\n    70→          .ilike(\"full_name\", values.identifier)\n    71→          .maybeSingle();\n    72→\n    73→        if (profileError && profileError.code !== \"42P01\") {\n    74→          setSubmitError(t(\"errors.genericError\"));\n    75→          setIsSubmitting(false);\n    76→          return;\n    77→        }\n    78→\n    79→        if (!profileData) {\n    80→          setSubmitError(t(\"errors.userNotFound\"));\n    81→          setIsSubmitting(false);\n    82→          return;\n    83→        }\n    84→\n    85→        // Get the user's email from auth.users via the profile id\n    86→        // Since we can't directly query auth.users from client, we use the placeholder email pattern\n    87→        // The placeholder email format is: username@placeholder.local\n    88→        email = `${values.identifier.toLowerCase().replace(/\\s+/g, \"_\")}@placeholder.local`;\n    89→      }\n    90→\n    91→      // Attempt to sign in with email and password\n    92→      const { error } = await supabase.auth.signInWithPassword({\n    93→        email,\n    94→        password: values.password,\n    95→      });\n    96→\n    97→      if (error) {\n    98→        if (error.message.includes(\"Invalid login credentials\")) {\n    99→          setSubmitError(t(\"errors.invalidCredentials\"));\n   100→        } else {\n   101→          setSubmitError(error.message || t(\"errors.genericError\"));\n   102→        }\n   103→        return;\n   104→      }\n   105→\n   106→      // Success\n   107→      setSubmitSuccess(t(\"success\"));\n   108→      form.reset();\n   109→      onSuccess?.();\n   110→    } catch {\n   111→      setSubmitError(t(\"errors.genericError\"));\n   112→    } finally {\n   113→      setIsSubmitting(false);\n   114→    }\n   115→  };\n   116→\n   117→  const handleGoogleLogin = async () => {\n   118→    setSubmitError(null);\n   119→    try {\n   120→      const { error } = await supabase.auth.signInWithOAuth({\n   121→        provider: \"google\",\n   122→        options: {\n   123→          redirectTo: `${window.location.origin}/auth/callback`,\n   124→        },\n   125→      });\n   126→\n   127→      if (error) {\n   128→        setSubmitError(error.message || t(\"errors.genericError\"));\n   129→      }\n   130→    } catch {\n   131→      setSubmitError(t(\"errors.genericError\"));\n   132→    }\n   133→  };\n   134→\n   135→  return (\n   136→    <Form {...form}>\n   137→      <form onSubmit={form.handleSubmit(onSubmit)} className=\"space-y-6\">\n   138→        <FormField\n   139→          control={form.control}\n   140→          name=\"identifier\"\n   141→          render={({ field }) => (\n   142→            <FormItem>\n   143→              <FormLabel>{t(\"identifier\")}</FormLabel>\n   144→              <FormControl>\n   145→                <Input\n   146→                  placeholder={t(\"identifierPlaceholder\")}\n   147→                  {...field}\n   148→                  autoComplete=\"username\"\n   149→                />\n   150→              </FormControl>\n   151→              <FormMessage />\n   152→            </FormItem>\n   153→          )}\n   154→        />\n   155→\n   156→        <FormField\n   157→          control={form.control}\n   158→          name=\"password\"\n   159→          render={({ field }) => (\n   160→            <FormItem>\n   161→              <FormLabel>{t(\"password\")}</FormLabel>\n   162→              <FormControl>\n   163→                <Input\n   164→                  type=\"password\"\n   165→                  placeholder={t(\"passwordPlaceholder\")}\n   166→                  {...field}\n   167→                  autoComplete=\"current-password\"\n   168→                />\n   169→              </FormControl>\n   170→              <FormMessage />\n   171→            </FormItem>\n   172→          )}\n   173→        />\n   174→\n   175→        {submitError && (\n   176→          <div className=\"rounded-md bg-destructive/10 p-3 text-sm text-destructive\">\n   177→            {submitError}\n   178→          </div>\n   179→        )}\n   180→\n   181→        {submitSuccess && (\n   182→          <div className=\"rounded-md bg-green-500/10 p-3 text-sm text-green-600 dark:text-green-400\">\n   183→            {submitSuccess}\n   184→          </div>\n   185→        )}\n   186→\n   187→        <Button type=\"submit\" className=\"w-full\" disabled={isSubmitting}>\n   188→          {isSubmitting ? (\n   189→            <>\n   190→              <Loader2 className=\"mr-2 h-4 w-4 animate-spin\" />\n   191→              {t(\"submitting\")}\n   192→            </>\n   193→          ) : (\n   194→            t(\"submit\")\n   195→          )}\n   196→        </Button>\n   197→\n   198→        <div className=\"relative\">\n   199→          <div className=\"absolute inset-0 flex items-center\">\n   200→            <span className=\"w-full border-t\" />\n   201→          </div>\n   202→          <div className=\"relative flex justify-center text-xs uppercase\">\n   203→            <span className=\"bg-card px-2 text-muted-foreground\">\n   204→              {t(\"orContinueWith\")}\n   205→            </span>\n   206→          </div>\n   207→        </div>\n   208→\n   209→        <Button\n   210→          type=\"button\"\n   211→          variant=\"outline\"\n   212→          className=\"w-full\"\n   213→          onClick={handleGoogleLogin}\n   214→        >\n   215→          <svg className=\"mr-2 h-4 w-4\" viewBox=\"0 0 24 24\">\n   216→            <path\n   217→              fill=\"currentColor\"\n   218→              d=\"M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z\"\n   219→            />\n   220→            <path\n   221→              fill=\"currentColor\"\n   222→              d=\"M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z\"\n   223→            />\n   224→            <path\n   225→              fill=\"currentColor\"\n   226→              d=\"M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z\"\n   227→            />\n   228→            <path\n   229→              fill=\"currentColor\"\n   230→              d=\"M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z\"\n   231→            />\n   232→          </svg>\n   233→          {t(\"google\")}\n   234→        </Button>\n   235→      </form>\n   236→    </Form>\n   237→  );\n   238→}\n   239→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"bf186ce8-bbc8-474d-8394-9852a20e107e","uuid":"4d54b4a6-05c1-4744-b543-505ce2c3c33f","tool_use_result":{"type":"text","file":{"filePath":"/Users/anayusta/workspace/roundnet/src/components/login-form.tsx","content":"\"use client\";\n\nimport { useState } from \"react\";\nimport { useForm } from \"react-hook-form\";\nimport { zodResolver } from \"@hookform/resolvers/zod\";\nimport { z } from \"zod\";\nimport { useTranslations } from \"next-intl\";\nimport { Loader2 } from \"lucide-react\";\n\nimport { Button } from \"@/components/ui/button\";\nimport { Input } from \"@/components/ui/input\";\nimport {\n  Form,\n  FormControl,\n  FormField,\n  FormItem,\n  FormLabel,\n  FormMessage,\n} from \"@/components/ui/form\";\nimport { supabase } from \"@/lib/supabase\";\n\nconst createLoginSchema = (t: ReturnType<typeof useTranslations<\"login\">>) =>\n  z.object({\n    identifier: z.string().min(1, t(\"errors.identifierRequired\")),\n    password: z.string().min(1, t(\"errors.passwordRequired\")),\n  });\n\ntype LoginFormValues = z.infer<ReturnType<typeof createLoginSchema>>;\n\nfunction isEmail(value: string): boolean {\n  const emailRegex = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\n  return emailRegex.test(value);\n}\n\ninterface LoginFormProps {\n  onSuccess?: () => void;\n}\n\nexport function LoginForm({ onSuccess }: LoginFormProps) {\n  const t = useTranslations(\"login\");\n  const [isSubmitting, setIsSubmitting] = useState(false);\n  const [submitError, setSubmitError] = useState<string | null>(null);\n  const [submitSuccess, setSubmitSuccess] = useState<string | null>(null);\n\n  const schema = createLoginSchema(t);\n\n  const form = useForm<LoginFormValues>({\n    resolver: zodResolver(schema),\n    defaultValues: {\n      identifier: \"\",\n      password: \"\",\n    },\n    mode: \"onChange\",\n  });\n\n  const onSubmit = async (values: LoginFormValues) => {\n    setIsSubmitting(true);\n    setSubmitError(null);\n    setSubmitSuccess(null);\n\n    try {\n      let email = values.identifier;\n\n      // Check if the identifier is an email or username\n      if (!isEmail(values.identifier)) {\n        // It's a username - need to look up the email\n        const { data: profileData, error: profileError } = await supabase\n          .from(\"profiles\")\n          .select(\"id\")\n          .ilike(\"full_name\", values.identifier)\n          .maybeSingle();\n\n        if (profileError && profileError.code !== \"42P01\") {\n          setSubmitError(t(\"errors.genericError\"));\n          setIsSubmitting(false);\n          return;\n        }\n\n        if (!profileData) {\n          setSubmitError(t(\"errors.userNotFound\"));\n          setIsSubmitting(false);\n          return;\n        }\n\n        // Get the user's email from auth.users via the profile id\n        // Since we can't directly query auth.users from client, we use the placeholder email pattern\n        // The placeholder email format is: username@placeholder.local\n        email = `${values.identifier.toLowerCase().replace(/\\s+/g, \"_\")}@placeholder.local`;\n      }\n\n      // Attempt to sign in with email and password\n      const { error } = await supabase.auth.signInWithPassword({\n        email,\n        password: values.password,\n      });\n\n      if (error) {\n        if (error.message.includes(\"Invalid login credentials\")) {\n          setSubmitError(t(\"errors.invalidCredentials\"));\n        } else {\n          setSubmitError(error.message || t(\"errors.genericError\"));\n        }\n        return;\n      }\n\n      // Success\n      setSubmitSuccess(t(\"success\"));\n      form.reset();\n      onSuccess?.();\n    } catch {\n      setSubmitError(t(\"errors.genericError\"));\n    } finally {\n      setIsSubmitting(false);\n    }\n  };\n\n  const handleGoogleLogin = async () => {\n    setSubmitError(null);\n    try {\n      const { error } = await supabase.auth.signInWithOAuth({\n        provider: \"google\",\n        options: {\n          redirectTo: `${window.location.origin}/auth/callback`,\n        },\n      });\n\n      if (error) {\n        setSubmitError(error.message || t(\"errors.genericError\"));\n      }\n    } catch {\n      setSubmitError(t(\"errors.genericError\"));\n    }\n  };\n\n  return (\n    <Form {...form}>\n      <form onSubmit={form.handleSubmit(onSubmit)} className=\"space-y-6\">\n        <FormField\n          control={form.control}\n          name=\"identifier\"\n          render={({ field }) => (\n            <FormItem>\n              <FormLabel>{t(\"identifier\")}</FormLabel>\n              <FormControl>\n                <Input\n                  placeholder={t(\"identifierPlaceholder\")}\n                  {...field}\n                  autoComplete=\"username\"\n                />\n              </FormControl>\n              <FormMessage />\n            </FormItem>\n          )}\n        />\n\n        <FormField\n          control={form.control}\n          name=\"password\"\n          render={({ field }) => (\n            <FormItem>\n              <FormLabel>{t(\"password\")}</FormLabel>\n              <FormControl>\n                <Input\n                  type=\"password\"\n                  placeholder={t(\"passwordPlaceholder\")}\n                  {...field}\n                  autoComplete=\"current-password\"\n                />\n              </FormControl>\n              <FormMessage />\n            </FormItem>\n          )}\n        />\n\n        {submitError && (\n          <div className=\"rounded-md bg-destructive/10 p-3 text-sm text-destructive\">\n            {submitError}\n          </div>\n        )}\n\n        {submitSuccess && (\n          <div className=\"rounded-md bg-green-500/10 p-3 text-sm text-green-600 dark:text-green-400\">\n            {submitSuccess}\n          </div>\n        )}\n\n        <Button type=\"submit\" className=\"w-full\" disabled={isSubmitting}>\n          {isSubmitting ? (\n            <>\n              <Loader2 className=\"mr-2 h-4 w-4 animate-spin\" />\n              {t(\"submitting\")}\n            </>\n          ) : (\n            t(\"submit\")\n          )}\n        </Button>\n\n        <div className=\"relative\">\n          <div className=\"absolute inset-0 flex items-center\">\n            <span className=\"w-full border-t\" />\n          </div>\n          <div className=\"relative flex justify-center text-xs uppercase\">\n            <span className=\"bg-card px-2 text-muted-foreground\">\n              {t(\"orContinueWith\")}\n            </span>\n          </div>\n        </div>\n\n        <Button\n          type=\"button\"\n          variant=\"outline\"\n          className=\"w-full\"\n          onClick={handleGoogleLogin}\n        >\n          <svg className=\"mr-2 h-4 w-4\" viewBox=\"0 0 24 24\">\n            <path\n              fill=\"currentColor\"\n              d=\"M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z\"\n            />\n            <path\n              fill=\"currentColor\"\n              d=\"M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z\"\n            />\n            <path\n              fill=\"currentColor\"\n              d=\"M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z\"\n            />\n            <path\n              fill=\"currentColor\"\n              d=\"M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z\"\n            />\n          </svg>\n          {t(\"google\")}\n        </Button>\n      </form>\n    </Form>\n  );\n}\n","numLines":239,"startLine":1,"totalLines":239}}}
