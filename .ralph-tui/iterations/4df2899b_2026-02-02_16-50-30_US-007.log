{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01AAJtsXyEML94yFzBwUQanu","type":"tool_result","content":"     1→\"use client\";\n     2→\n     3→import { useState, useEffect, useCallback } from \"react\";\n     4→import { useForm } from \"react-hook-form\";\n     5→import { zodResolver } from \"@hookform/resolvers/zod\";\n     6→import { z } from \"zod\";\n     7→import { useTranslations } from \"next-intl\";\n     8→import { CheckCircle, XCircle, Loader2 } from \"lucide-react\";\n     9→\n    10→import { Button } from \"@/components/ui/button\";\n    11→import { Input } from \"@/components/ui/input\";\n    12→import {\n    13→  Form,\n    14→  FormControl,\n    15→  FormDescription,\n    16→  FormField,\n    17→  FormItem,\n    18→  FormLabel,\n    19→  FormMessage,\n    20→} from \"@/components/ui/form\";\n    21→import { cn } from \"@/lib/utils\";\n    22→import { supabase } from \"@/lib/supabase\";\n    23→\n    24→const createRegistrationSchema = (t: ReturnType<typeof useTranslations<\"registration\">>) =>\n    25→  z\n    26→    .object({\n    27→      fullName: z\n    28→        .string()\n    29→        .min(1, t(\"errors.fullNameRequired\"))\n    30→        .min(2, t(\"errors.fullNameMinLength\"))\n    31→        .max(100, t(\"errors.fullNameMaxLength\")),\n    32→      email: z\n    33→        .string()\n    34→        .email(t(\"errors.emailInvalid\"))\n    35→        .optional()\n    36→        .or(z.literal(\"\")),\n    37→      password: z\n    38→        .string()\n    39→        .min(1, t(\"errors.passwordRequired\"))\n    40→        .min(8, t(\"errors.passwordMinLength\")),\n    41→      confirmPassword: z.string(),\n    42→    })\n    43→    .refine((data) => data.password === data.confirmPassword, {\n    44→      message: t(\"errors.passwordsDoNotMatch\"),\n    45→      path: [\"confirmPassword\"],\n    46→    });\n    47→\n    48→type RegistrationFormValues = z.infer<ReturnType<typeof createRegistrationSchema>>;\n    49→\n    50→type UsernameStatus = \"idle\" | \"checking\" | \"available\" | \"taken\";\n    51→\n    52→interface RegistrationFormProps {\n    53→  onSuccess?: () => void;\n    54→}\n    55→\n    56→export function RegistrationForm({ onSuccess }: RegistrationFormProps) {\n    57→  const t = useTranslations(\"registration\");\n    58→  const [isSubmitting, setIsSubmitting] = useState(false);\n    59→  const [submitError, setSubmitError] = useState<string | null>(null);\n    60→  const [submitSuccess, setSubmitSuccess] = useState<string | null>(null);\n    61→  const [usernameStatus, setUsernameStatus] = useState<UsernameStatus>(\"idle\");\n    62→\n    63→  const schema = createRegistrationSchema(t);\n    64→\n    65→  const form = useForm<RegistrationFormValues>({\n    66→    resolver: zodResolver(schema),\n    67→    defaultValues: {\n    68→      fullName: \"\",\n    69→      email: \"\",\n    70→      password: \"\",\n    71→      confirmPassword: \"\",\n    72→    },\n    73→    mode: \"onChange\",\n    74→  });\n    75→\n    76→  const fullNameValue = form.watch(\"fullName\");\n    77→\n    78→  const checkUsernameAvailability = useCallback(\n    79→    async (username: string) => {\n    80→      if (!username || username.length < 2) {\n    81→        setUsernameStatus(\"idle\");\n    82→        return;\n    83→      }\n    84→\n    85→      setUsernameStatus(\"checking\");\n    86→\n    87→      try {\n    88→        const { data, error } = await supabase\n    89→          .from(\"profiles\")\n    90→          .select(\"full_name\")\n    91→          .ilike(\"full_name\", username)\n    92→          .maybeSingle();\n    93→\n    94→        if (error) {\n    95→          // Table might not exist yet, treat as available\n    96→          setUsernameStatus(\"available\");\n    97→          return;\n    98→        }\n    99→\n   100→        if (data) {\n   101→          setUsernameStatus(\"taken\");\n   102→          form.setError(\"fullName\", {\n   103→            type: \"manual\",\n   104→            message: t(\"errors.fullNameTaken\"),\n   105→          });\n   106→        } else {\n   107→          setUsernameStatus(\"available\");\n   108→          form.clearErrors(\"fullName\");\n   109→        }\n   110→      } catch {\n   111→        // On network error, allow form submission (server will validate)\n   112→        setUsernameStatus(\"available\");\n   113→      }\n   114→    },\n   115→    [form, t]\n   116→  );\n   117→\n   118→  // Debounced username check\n   119→  useEffect(() => {\n   120→    const timeoutId = setTimeout(() => {\n   121→      if (fullNameValue && fullNameValue.length >= 2) {\n   122→        checkUsernameAvailability(fullNameValue);\n   123→      } else {\n   124→        setUsernameStatus(\"idle\");\n   125→      }\n   126→    }, 500);\n   127→\n   128→    return () => clearTimeout(timeoutId);\n   129→  }, [fullNameValue, checkUsernameAvailability]);\n   130→\n   131→  const onSubmit = async (values: RegistrationFormValues) => {\n   132→    setIsSubmitting(true);\n   133→    setSubmitError(null);\n   134→    setSubmitSuccess(null);\n   135→\n   136→    try {\n   137→      // Final check for username availability\n   138→      if (usernameStatus === \"taken\") {\n   139→        setSubmitError(t(\"errors.fullNameTaken\"));\n   140→        setIsSubmitting(false);\n   141→        return;\n   142→      }\n   143→\n   144→      const { error } = await supabase.auth.signUp({\n   145→        email: values.email || `${values.fullName.toLowerCase().replace(/\\s+/g, \"_\")}@placeholder.local`,\n   146→        password: values.password,\n   147→        options: {\n   148→          data: {\n   149→            full_name: values.fullName,\n   150→          },\n   151→          emailRedirectTo: values.email ? `${window.location.origin}/auth/callback` : undefined,\n   152→        },\n   153→      });\n   154→\n   155→      if (error) {\n   156→        if (error.message.includes(\"duplicate\") || error.message.includes(\"already\")) {\n   157→          setSubmitError(t(\"errors.fullNameTaken\"));\n   158→        } else {\n   159→          setSubmitError(error.message || t(\"errors.registrationFailed\"));\n   160→        }\n   161→        return;\n   162→      }\n   163→\n   164→      // Success\n   165→      if (values.email) {\n   166→        setSubmitSuccess(t(\"successWithEmail\"));\n   167→      } else {\n   168→        setSubmitSuccess(t(\"success\"));\n   169→      }\n   170→\n   171→      form.reset();\n   172→      onSuccess?.();\n   173→    } catch {\n   174→      setSubmitError(t(\"errors.genericError\"));\n   175→    } finally {\n   176→      setIsSubmitting(false);\n   177→    }\n   178→  };\n   179→\n   180→  const getUsernameStatusIcon = () => {\n   181→    switch (usernameStatus) {\n   182→      case \"checking\":\n   183→        return <Loader2 className=\"h-4 w-4 animate-spin text-muted-foreground\" />;\n   184→      case \"available\":\n   185→        return <CheckCircle className=\"h-4 w-4 text-green-500\" />;\n   186→      case \"taken\":\n   187→        return <XCircle className=\"h-4 w-4 text-destructive\" />;\n   188→      default:\n   189→        return null;\n   190→    }\n   191→  };\n   192→\n   193→  const getUsernameStatusText = () => {\n   194→    switch (usernameStatus) {\n   195→      case \"checking\":\n   196→        return t(\"errors.fullNameChecking\");\n   197→      case \"available\":\n   198→        return t(\"errors.fullNameAvailable\");\n   199→      case \"taken\":\n   200→        return t(\"errors.fullNameTaken\");\n   201→      default:\n   202→        return t(\"fullNameDescription\");\n   203→    }\n   204→  };\n   205→\n   206→  return (\n   207→    <Form {...form}>\n   208→      <form onSubmit={form.handleSubmit(onSubmit)} className=\"space-y-6\">\n   209→        <FormField\n   210→          control={form.control}\n   211→          name=\"fullName\"\n   212→          render={({ field }) => (\n   213→            <FormItem>\n   214→              <FormLabel>{t(\"fullName\")}</FormLabel>\n   215→              <FormControl>\n   216→                <div className=\"relative\">\n   217→                  <Input\n   218→                    placeholder={t(\"fullNamePlaceholder\")}\n   219→                    {...field}\n   220→                    className={cn(\n   221→                      usernameStatus === \"taken\" && \"border-destructive\",\n   222→                      usernameStatus === \"available\" && \"border-green-500\"\n   223→                    )}\n   224→                  />\n   225→                  <div className=\"absolute right-3 top-1/2 -translate-y-1/2\">\n   226→                    {getUsernameStatusIcon()}\n   227→                  </div>\n   228→                </div>\n   229→              </FormControl>\n   230→              <FormDescription\n   231→                className={cn(\n   232→                  usernameStatus === \"taken\" && \"text-destructive\",\n   233→                  usernameStatus === \"available\" && \"text-green-500\"\n   234→                )}\n   235→              >\n   236→                {getUsernameStatusText()}\n   237→              </FormDescription>\n   238→              <FormMessage />\n   239→            </FormItem>\n   240→          )}\n   241→        />\n   242→\n   243→        <FormField\n   244→          control={form.control}\n   245→          name=\"email\"\n   246→          render={({ field }) => (\n   247→            <FormItem>\n   248→              <FormLabel>{t(\"email\")}</FormLabel>\n   249→              <FormControl>\n   250→                <Input\n   251→                  type=\"email\"\n   252→                  placeholder={t(\"emailPlaceholder\")}\n   253→                  {...field}\n   254→                />\n   255→              </FormControl>\n   256→              <FormDescription>{t(\"emailDescription\")}</FormDescription>\n   257→              <FormMessage />\n   258→            </FormItem>\n   259→          )}\n   260→        />\n   261→\n   262→        <FormField\n   263→          control={form.control}\n   264→          name=\"password\"\n   265→          render={({ field }) => (\n   266→            <FormItem>\n   267→              <FormLabel>{t(\"password\")}</FormLabel>\n   268→              <FormControl>\n   269→                <Input\n   270→                  type=\"password\"\n   271→                  placeholder={t(\"passwordPlaceholder\")}\n   272→                  {...field}\n   273→                />\n   274→              </FormControl>\n   275→              <FormDescription>{t(\"passwordDescription\")}</FormDescription>\n   276→              <FormMessage />\n   277→            </FormItem>\n   278→          )}\n   279→        />\n   280→\n   281→        <FormField\n   282→          control={form.control}\n   283→          name=\"confirmPassword\"\n   284→          render={({ field }) => (\n   285→            <FormItem>\n   286→              <FormLabel>{t(\"confirmPassword\")}</FormLabel>\n   287→              <FormControl>\n   288→                <Input\n   289→                  type=\"password\"\n   290→                  placeholder={t(\"confirmPasswordPlaceholder\")}\n   291→                  {...field}\n   292→                />\n   293→              </FormControl>\n   294→              <FormMessage />\n   295→            </FormItem>\n   296→          )}\n   297→        />\n   298→\n   299→        {submitError && (\n   300→          <div className=\"rounded-md bg-destructive/10 p-3 text-sm text-destructive\">\n   301→            {submitError}\n   302→          </div>\n   303→        )}\n   304→\n   305→        {submitSuccess && (\n   306→          <div className=\"rounded-md bg-green-500/10 p-3 text-sm text-green-600 dark:text-green-400\">\n   307→            {submitSuccess}\n   308→          </div>\n   309→        )}\n   310→\n   311→        <Button\n   312→          type=\"submit\"\n   313→          className=\"w-full\"\n   314→          disabled={isSubmitting || user