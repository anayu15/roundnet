Response.redirect(`${origin}/es?error=auth_callback_failed`);\n    }\n\n    // Check if the user has a profile with a username (full_name)\n    if (sessionData?.user) {\n      const { data: profile } = await supabase\n        .from(\"profiles\")\n        .select(\"full_name\")\n        .eq(\"id\", sessionData.user.id)\n        .maybeSingle();\n\n      // If no profile or no username, redirect to complete profile page\n      if (!profile?.full_name) {\n        return NextResponse.redirect(`${origin}/es/complete-profile`);\n      }\n    }\n  }\n\n  // Redirect to the default locale home page after successful verification\n  return NextResponse.redirect(`${origin}/es`);\n}"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":273,"cache_read_input_tokens":39307,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":273},"output_tokens":4,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"bf186ce8-bbc8-474d-8394-9852a20e107e","uuid":"f8587a5f-a6ac-4453-b08d-ef0fb43feebb"}
