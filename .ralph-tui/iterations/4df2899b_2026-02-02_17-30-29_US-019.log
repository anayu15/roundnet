{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01WEi8w6umTEcEcrE7G2h1X6","type":"tool_result","content":"     1→\"use client\";\n     2→\n     3→import { useState, useEffect } from \"react\";\n     4→import { useRouter } from \"next/navigation\";\n     5→import { useForm } from \"react-hook-form\";\n     6→import { zodResolver } from \"@hookform/resolvers/zod\";\n     7→import { z } from \"zod\";\n     8→import { useLocale, useTranslations } from \"next-intl\";\n     9→import Link from \"next/link\";\n    10→import {\n    11→  Loader2,\n    12→  User,\n    13→  Mail,\n    14→  Calendar,\n    15→  Shield,\n    16→  Eye,\n    17→  EyeOff,\n    18→  CheckCircle2,\n    19→  Clock,\n    20→  XCircle,\n    21→  AlertCircle,\n    22→} from \"lucide-react\";\n    23→\n    24→import { Button } from \"@/components/ui/button\";\n    25→import { Input } from \"@/components/ui/input\";\n    26→import {\n    27→  Form,\n    28→  FormControl,\n    29→  FormDescription,\n    30→  FormField,\n    31→  FormItem,\n    32→  FormLabel,\n    33→  FormMessage,\n    34→} from \"@/components/ui/form\";\n    35→import { supabase } from \"@/lib/supabase\";\n    36→\n    37→type UserProfile = {\n    38→  id: string;\n    39→  full_name: string;\n    40→  email: string | null;\n    41→  created_at: string;\n    42→};\n    43→\n    44→type MembershipStatus = \"pending\" | \"active\" | \"expired\" | null;\n    45→\n    46→type Membership = {\n    47→  id: string;\n    48→  status: MembershipStatus;\n    49→  applied_at: string;\n    50→  expires_at: string | null;\n    51→};\n    52→\n    53→const createEmailSchema = (t: ReturnType<typeof useTranslations<\"profile\">>) =>\n    54→  z.object({\n    55→    email: z.string().email(t(\"errors.emailInvalid\")),\n    56→  });\n    57→\n    58→const createPasswordSchema = (t: ReturnType<typeof useTranslations<\"profile\">>) =>\n    59→  z\n    60→    .object({\n    61→      currentPassword: z.string().min(1, t(\"errors.currentPasswordRequired\")),\n    62→      newPassword: z.string().min(8, t(\"errors.passwordMinLength\")),\n    63→      confirmPassword: z.string().min(1, t(\"errors.confirmPasswordRequired\")),\n    64→    })\n    65→    .refine((data) => data.newPassword === data.confirmPassword, {\n    66→      message: t(\"errors.passwordsDoNotMatch\"),\n    67→      path: [\"confirmPassword\"],\n    68→    });\n    69→\n    70→type EmailFormValues = z.infer<ReturnType<typeof createEmailSchema>>;\n    71→type PasswordFormValues = z.infer<ReturnType<typeof createPasswordSchema>>;\n    72→\n    73→export function ProfileContent() {\n    74→  const t = useTranslations(\"profile\");\n    75→  const locale = useLocale();\n    76→  const router = useRouter();\n    77→  const [isLoading, setIsLoading] = useState(true);\n    78→  const [profile, setProfile] = useState<UserProfile | null>(null);\n    79→  const [authEmail, setAuthEmail] = useState<string | null>(null);\n    80→  const [membership, setMembership] = useState<Membership | null>(null);\n    81→\n    82→  // Email form state\n    83→  const [isEmailSubmitting, setIsEmailSubmitting] = useState(false);\n    84→  const [emailError, setEmailError] = useState<string | null>(null);\n    85→  const [emailSuccess, setEmailSuccess] = useState<string | null>(null);\n    86→\n    87→  // Password form state\n    88→  const [isPasswordSubmitting, setIsPasswordSubmitting] = useState(false);\n    89→  const [passwordError, setPasswordError] = useState<string | null>(null);\n    90→  const [passwordSuccess, setPasswordSuccess] = useState<string | null>(null);\n    91→  const [showCurrentPassword, setShowCurrentPassword] = useState(false);\n    92→  const [showNewPassword, setShowNewPassword] = useState(false);\n    93→  const [showConfirmPassword, setShowConfirmPassword] = useState(false);\n    94→\n    95→  const emailSchema = createEmailSchema(t);\n    96→  const passwordSchema = createPasswordSchema(t);\n    97→\n    98→  const emailForm = useForm<EmailFormValues>({\n    99→    resolver: zodResolver(emailSchema),\n   100→    defaultValues: {\n   101→      email: \"\",\n   102→    },\n   103→  });\n   104→\n   105→  const passwordForm = useForm<PasswordFormValues>({\n   106→    resolver: zodResolver(passwordSchema),\n   107→    defaultValues: {\n   108→      currentPassword: \"\",\n   109→      newPassword: \"\",\n   110→      confirmPassword: \"\",\n   111→    },\n   112→  });\n   113→\n   114→  useEffect(() => {\n   115→    const checkAuthAndLoadProfile = async () => {\n   116→      const { data: { user } } = await supabase.auth.getUser();\n   117→\n   118→      if (!user) {\n   119→        router.push(`/${locale}/login`);\n   120→        return;\n   121→      }\n   122→\n   123→      setAuthEmail(user.email || null);\n   124→\n   125→      const { data: profileData } = await supabase\n   126→        .from(\"profiles\")\n   127→        .select(\"id, full_name, email, created_at\")\n   128→        .eq(\"id\", user.id)\n   129→        .maybeSingle();\n   130→\n   131→      if (profileData) {\n   132→        setProfile(profileData);\n   133→        if (profileData.email) {\n   134→          emailForm.setValue(\"email\", profileData.email);\n   135→        }\n   136→      }\n   137→\n   138→      // Load membership status\n   139→      const { data: membershipData } = await supabase\n   140→        .from(\"memberships\")\n   141→        .select(\"id, status, applied_at, expires_at\")\n   142→        .eq(\"user_id\", user.id)\n   143→        .order(\"applied_at\", { ascending: false })\n   144→        .limit(1)\n   145→        .maybeSingle();\n   146→\n   147→      if (membershipData) {\n   148→        setMembership(membershipData);\n   149→      }\n   150→\n   151→      setIsLoading(false);\n   152→    };\n   153→\n   154→    checkAuthAndLoadProfile();\n   155→  }, [locale, router, emailForm]);\n   156→\n   157→  const onEmailSubmit = async (values: EmailFormValues) => {\n   158→    setIsEmailSubmitting(true);\n   159→    setEmailError(null);\n   160→    setEmailSuccess(null);\n   161→\n   162→    try {\n   163→      const { data: { user } } = await supabase.auth.getUser();\n   164→\n   165→      if (!user) {\n   166→        setEmailError(t(\"errors.notAuthenticated\"));\n   167→        return;\n   168→      }\n   169→\n   170→      // Update email in Supabase Auth (this sends verification email)\n   171→      const { error: authError } = await supabase.auth.updateUser({\n   172→        email: values.email,\n   173→      });\n   174→\n   175→      if (authError) {\n   176→        setEmailError(authError.message);\n   177→        return;\n   178→      }\n   179→\n   180→      // Update email in profiles table\n   181→      const { error: profileError } = await supabase\n   182→        .from(\"profiles\")\n   183→        .update({ email: values.email })\n   184→        .eq(\"id\", user.id);\n   185→\n   186→      if (profileError) {\n   187→        setEmailError(profileError.message);\n   188→        return;\n   189→      }\n   190→\n   191→      setEmailSuccess(t(\"emailUpdateSuccess\"));\n   192→      setProfile((prev) => prev ? { ...prev, email: values.email } : null);\n   193→    } catch {\n   194→      setEmailError(t(\"errors.genericError\"));\n   195→    } finally {\n   196→      setIsEmailSubmitting(false);\n   197→    }\n   198→  };\n   199→\n   200→  const onPasswordSubmit = async (values: PasswordFormValues) => {\n   201→    setIsPasswordSubmitting(true);\n   202→    setPasswordError(null);\n   203→    setPasswordSuccess(null);\n   204→\n   205→    try {\n   206→      const { data: { user } } = await supabase.auth.getUser();\n   207→\n   208→      if (!user) {\n   209→        setPasswordError(t(\"errors.notAuthenticated\"));\n   210→        return;\n   211→      }\n   212→\n   213→      // First verify the current password by attempting to sign in\n   214→      const email = authEmail || profile?.email;\n   215→      if (!email) {\n   216→        setPasswordError(t(\"errors.noEmailForPasswordChange\"));\n   217→        return;\n   218→      }\n   219→\n   220→      const { error: signInError } = await supabase.auth.signInWithPassword({\n   221→        email,\n   222→        password: values.currentPassword,\n   223→      });\n   224→\n   225→      if (signInError) {\n   226→        setPasswordError(t(\"errors.currentPasswordInvalid\"));\n   227→        return;\n   228→      }\n   229→\n   230→      // Update password\n   231→      const { error: updateError } = await supabase.auth.updateUser({\n   232→        password: values.newPassword,\n   233→      });\n   234→\n   235→      if (updateError) {\n   236→        setPasswordError(updateError.message);\n   237→        return;\n   238→      }\n   239→\n   240→      setPasswordSuccess(t(\"passwordUpdateSuccess\"));\n   241→      passwordForm.reset();\n   242→    } catch {\n   243→      setPasswordError(t(\"errors.genericError\"));\n   244→    } finally {\n   245→      setIsPasswordSubmitting(false);\n   246→    }\n   247→  };\n   248→\n   249→  const formatDate = (dateString: string) => {\n   250→    return new Date(dateString).toLocaleDateString(locale === \"es\" ? \"es-ES\" : \"en-US\", {\n   251→      year: \"numeric\",\n   252→      month: \"long\",\n   253→      day: \"numeric\",\n   254→    });\n   255→  };\n   256→\n   257→  const getMembershipStatusIcon = (status: MembershipStatus) => {\n   258→    switch (status) {\n   259→      case \"active\":\n   260→        return <CheckCircle2 className=\"h-5 w-5 text-green-500\" />;\n   261→      case \"pending\":\n   262→        return <Clock className=\"h-5 w-5 text-yellow-500\" />;\n   263→      case \"expired\":\n   264→        return <XCircle className=\"h-5 w-5 text-red-500\" />;\n   265→      default:\n   266→        return <AlertCircle className=\"h-5 w-5 text-muted-foreground\" />;\n   267→    }\n   268→  };\n   269→\n   270→  const getMembershipStatusText = (status: MembershipStatus) => {\n   271→    switch (status) {\n   272→      case \"active\":\n   273→        return t(\"memberStatusActive\");\n   274→      case \"pending\":\n   275→        return t(\"memberStatusPending\");\n   276→      case \"expired\":\n   277→        return t(\"memberStatusExpired\");\n   278→      default:\n   279→        return t(\"memberStatusNone\");\n   280→    }\n   281→  };\n   282→\n   283→  if (isLoading) {\n   284→    return (\n   285→      <div className=\"flex min-h-[calc(100vh-8rem)] items-center justify-center\">\n   286→        <Loader2 className=\"h-8 w-8 animate-spin text-muted-foreground\" />\n   287→      </div>\n   288→    );\n   289→  }\n   290→\n   291→  return (\n   292→    <div className=\"container mx-auto px-4 py-8 max-w-2xl\">\n   293→      <h1 className=\"text-3xl font-bold tracking-tight mb-8\">{t(\"title\")}</h1>\n   294→\n   295→      {/* Profile Information Card */}\n   296→      <div className=\"rounded-lg border bg-card p-6 shadow-sm mb-6\">\n   297→        <h2 className=\"text-xl font-semibold mb-4\">{t(\"profileInfo\")}</h2>\n   298→\n   299→        <div className=\"space-y-4\">\n   300→          {/* Username */}\n   301→          <div className=\"flex items-start gap-3\">\n   302→            <User className=\"h-5 w-5 text-muted-foreground mt-0.5\" />\n   303→            <div>\n   304→              <p className=\"text-sm font-medium text-muted-foreground\">{t(\"username\")}</p>\n   305→              <p className=\"text-base\">{profile?.full_name}</p>\n   306→              <p className=\"text-xs text-muted-foreground mt-1\">{t(\"usernameNote\")}</p>\n   307→            </div>\n   308→          </div>\n   309→\n   310→          {/* Email */}\n   311→          <div className=\"flex items-start gap-3\">\n   312→            <Mail className=\"h-5 w-5 text-muted-foreground mt-0.5\" />\n   313→            <div>\n   314→              <p className=\"text-sm font-medium text-muted-foreground\">{t(\"email\")}</p>\n   315→              <p className=\"text-base\">{profile?.email || authEmail || t(\"noEmail\")}</p>\n   316→            </div>\n   317→          </div>\n   318→\n   319→          {/* Membership Status */}\n   320→          <div className=\"flex items-start gap-3\">\n   321→            {membership ? getMembershipStatusIcon(membership.status) : <Shield className=\"h-5 w-5 text-muted-foreground mt-0.5\" />}\n   322→            <div className=\"flex-1\">\n   323→              <p className=\"text-sm font-medium text-muted-foreground\">{t(\"membershipStatus\")}</p>\n   324→              <div className=\"flex items-center justify-between\">\n   325→                <p className=\"text-base\">{getMembershipStatusText(membership?.status || null)}</p>\n   326→                <Link\n   327→                  href={`/${locale}/membership`}\n   328→                  className=\"text-sm text-primary hover:underline\"\n   329→                >\n   330→                  {membership ? t(\"viewMembership\") : t(\"applyMembership\")}\n   331→                </Link>\n   332→              </div>\n   333→              {membership?.status === \"active\" && membership.expires_at && (\n   334→                <p className=\"text-xs text-muted-foreground mt-1\">\n   335→                  {t(\"expiresOn\")}: {formatDate(membership.expires_at)}\n   336→                </p>\n   337→              )}\n   338→              {membership?.status === \"pending\" && (\n   339→                <p className=\"text-xs text-yellow-600 dark:text-yellow-400 mt-1\">\n   340→                  {t(\"pendingVerification\")}\n   341→                </p>\n   342→              )}\n   343→            </div>\n   344→          </div>\n   345→\n   346→          {/* Registration Date */}\n   347→          <div className=\"flex items-start gap-3\">\n   348→            <Calendar className=\"h-5 w-5 text-muted-foreground mt-0.5\" />\n   349→            <div>\n   350→              <p className=\"text-sm font-medium text-muted-foreground\">{t(\"registrationDate\")}</p>\n   351→              <p className=\"text-base\">{profile?.created_at ? formatDate(profile.created_at) : \"-\"}</p>\n   352→            </div>\n   353→          </div>\n   354→        </div>\n   355→      </div>\n   356→\n   357→      {/* Update Email Card */}\n   358→      <div className=\"rounded-lg border bg-card p-6 shadow-sm mb-6\">\n   359→        <h2 className=\"text-xl font-semibold mb-4\">{t(\"updateEmail\")}</h2>\n   360→        <p className=\"text-sm text-muted-foreground mb-4\">{t(\"updateEmailDescription\")}</p>\n   361→\n   362→        <Form {...emailForm}>\n   363→          <form onSubmit={emailForm.handleSubmit(onEmailSubmit)} className=\"space-y-4\">\n   364→            <FormField\n   365→              control={emailForm.control}\n   366→              name=\"email\"\n   367→              render={({ field }) => (\n   368→                <FormItem>\n   369→                  <FormLabel>{t(\"newEmail\")}</FormLabel>\n   370→                  <FormControl>\n   371→                    <Input\n   372→                      type=\"email\"\n   373→                      placeholder={t(\"emailPlaceholder\")}\n   374→                      {...field}\n   375→                    />\n   376→                  </FormControl>\n   377→                  <FormDescription>{t(\"emailVerificationNote\")}</FormDescription>\n   378→                  <FormMessage />\n   379→                </FormItem>\n   380→              )}\n   381→            />\n   382→\n   383→            {emailError && (\n   384→              <div className=\"rounded-md bg-destructive/10 p-3 text-sm text-destructive\">\n   385→                {emailError}\n   386→              </div>\n   387→            )}\n   388→\n   389→            {emailSuccess && (\n   390→              <div className=\"rounded-md bg-green-500/10 p-3 text-sm text-green-600 dark:text-green-400\">\n   391→                {emailSuccess}\n   392→              </div>\n   393→            )}\n   394→\n   395→            <Button type=\"submit\" disabled={isEmailSubmitting}>\n   396→              {isEmailSubmitting ? (\n   397→                <>\n   398→                  <Loader2 className=\"mr-2 h-4 w-4 animate-spin\" />\n   399→                  {t(\"updating\")}\n   400→                </>\n   401→              ) : (\n   402→                t(\"updateEmailButton\")\n   403→              )}\n   404→            </Button>\n   405→          </form>\n   406→        </Form>\n   407→      </div>\n   408→\n   409→      {/* Change Password Card */}\n   410→      <div className=\"rounded-lg border bg-card p-6 shadow-sm\">\n   411→        <h2 className=\"text-xl font-semibold mb-4\">{t(\"changePassword\")}</h2>\n   412→        <p className=\"text-sm text-muted-foreground mb-4\">{t(\"changePasswordDescription\")}</p>\n   413→\n   414→        <Form {...passwordForm}>\n   415→          <form onSubmit={passwordForm.handleSubmit(onPasswordSubmit)} className=\"space-y-4\">\n   416→            <FormField\n   417→              control={passwordForm.control}\n   418→              name=\"currentPassword\"\n   419→              render={({ field }) => (\n   420→                <FormItem>\n   421→                  <FormLabel>{t(\"currentPassword\")}</FormLabel>\n   422→                  <FormControl>\n   423→                    <div className=\"relative\">\n   424→                      <Input\n   425→                        type={showCurrentPassword ? \"text\" : \"password\"}\n   426→                        placeholder={t(\"currentPasswordPlaceholder\")}\n   427→                        {...field}\n   428→                      />\n   429→                      <button\n   430→                        type=\"button\"\n   431→                        className=\"absolute right-3 top-1/2 -translate-y-1/2 text-muted-foreground hover:text-foreground\"\n   432→                        onClick={() => setShowCurrentPassword(!showCurrentPassword)}\n   433→                        tabIndex={-1}\n   434→                      >\n   435→                        {s