{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01KEpix7stnU9zuSNhiwmKSR","type":"tool_result","content":"     1→-- Create profiles table to store user profile data with unique full_name (username)\n     2→create table if not exists public.profiles (\n     3→  id uuid references auth.users on delete cascade primary key,\n     4→  full_name text not null unique,\n     5→  email text,\n     6→  created_at timestamptz default now() not null,\n     7→  updated_at timestamptz default now() not null\n     8→);\n     9→\n    10→-- Enable Row Level Security\n    11→alter table public.profiles enable row level security;\n    12→\n    13→-- Create policy to allow users to view their own profile\n    14→create policy \"Users can view own profile\"\n    15→  on public.profiles for select\n    16→  using (auth.uid() = id);\n    17→\n    18→-- Create policy to allow users to update their own profile\n    19→create policy \"Users can update own profile\"\n    20→  on public.profiles for update\n    21→  using (auth.uid() = id);\n    22→\n    23→-- Create policy to allow insert during registration (service role or authenticated)\n    24→create policy \"Enable insert for authenticated users only\"\n    25→  on public.profiles for insert\n    26→  with check (auth.uid() = id);\n    27→\n    28→-- Create policy to allow public read access for username uniqueness check\n    29→create policy \"Allow public read for username check\"\n    30→  on public.profiles for select\n    31→  using (true);\n    32→\n    33→-- Create function to handle user creation\n    34→create or replace function public.handle_new_user()\n    35→returns trigger\n    36→language plpgsql\n    37→security definer set search_path = ''\n    38→as $$\n    39→begin\n    40→  insert into public.profiles (id, full_name, email)\n    41→  values (\n    42→    new.id,\n    43→    new.raw_user_meta_data ->> 'full_name',\n    44→    new.email\n    45→  );\n    46→  return new;\n    47→end;\n    48→$$;\n    49→\n    50→-- Create trigger to automatically create profile on user signup\n    51→create trigger on_auth_user_created\n    52→  after insert on auth.users\n    53→  for each row execute procedure public.handle_new_user();\n    54→\n    55→-- Create index for faster username lookups\n    56→create index if not exists profiles_full_name_idx on public.profiles (lower(full_name));\n    57→\n    58→-- Create function to update the updated_at timestamp\n    59→create or replace function public.update_updated_at_column()\n    60→returns trigger\n    61→language plpgsql\n    62→as $$\n    63→begin\n    64→  new.updated_at = now();\n    65→  return new;\n    66→end;\n    67→$$;\n    68→\n    69→-- Create trigger to automatically update updated_at\n    70→create trigger update_profiles_updated_at\n    71→  before update on public.profiles\n    72→  for each row execute procedure public.update_updated_at_column();\n    73→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"38a89ce1-41c3-422b-b118-4d5db220655a","uuid":"cd9927e2-832a-4cf6-8778-0c546097f33f","tool_use_result":{"type":"text","file":{"filePath":"/Users/anayusta/workspace/roundnet/supabase/migrations/20260202000000_create_profiles_table.sql","content":"-- Create profiles table to store user profile data with unique full_name (username)\ncreate table if not exists public.profiles (\n  id uuid references auth.users on delete cascade primary key,\n  full_name text not null unique,\n  email text,\n  created_at timestamptz default now() not null,\n  updated_at timestamptz default now() not null\n);\n\n-- Enable Row Level Security\nalter table public.profiles enable row level security;\n\n-- Create policy to allow users to view their own profile\ncreate policy \"Users can view own profile\"\n  on public.profiles for select\n  using (auth.uid() = id);\n\n-- Create policy to allow users to update their own profile\ncreate policy \"Users can update own profile\"\n  on public.profiles for update\n  using (auth.uid() = id);\n\n-- Create policy to allow insert during registration (service role or authenticated)\ncreate policy \"Enable insert for authenticated users only\"\n  on public.profiles for insert\n  with check (auth.uid() = id);\n\n-- Create policy to allow public read access for username uniqueness check\ncreate policy \"Allow public read for username check\"\n  on public.profiles for select\n  using (true);\n\n-- Create function to handle user creation\ncreate or replace function public.handle_new_user()\nreturns trigger\nlanguage plpgsql\nsecurity definer set search_path = ''\nas $$\nbegin\n  insert into public.profiles (id, full_name, email)\n  values (\n    new.id,\n    new.raw_user_meta_data ->> 'full_name',\n    new.email\n  );\n  return new;\nend;\n$$;\n\n-- Create trigger to automatically create profile on user signup\ncreate trigger on_auth_user_created\n  after insert on auth.users\n  for each row execute procedure public.handle_new_user();\n\n-- Create index for faster username lookups\ncreate index if not exists profiles_full_name_idx on public.profiles (lower(full_name));\n\n-- Create function to update the updated_at timestamp\ncreate or replace function public.update_updated_at_column()\nreturns trigger\nlanguage plpgsql\nas $$\nbegin\n  new.updated_at = now();\n  return new;\nend;\n$$;\n\n-- Create trigger to automatically update updated_at\ncreate trigger update_profiles_updated_at\n  before update on public.profiles\n  for each row execute procedure public.update_updated_at_column();\n","numLines":73,"startLine":1,"totalLines":73}}}
