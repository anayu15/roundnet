{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CVsSYwdgJ79gKzRd2cTUkK","type":"tool_result","content":"     1→\"use client\";\n     2→\n     3→import { useState } from \"react\";\n     4→import Link from \"next/link\";\n     5→import { useLocale, useTranslations } from \"next-intl\";\n     6→import { Menu, X, User, LogIn } from \"lucide-react\";\n     7→import { LanguageSwitcher } from \"./language-switcher\";\n     8→import { cn } from \"@/lib/utils\";\n     9→\n    10→const navItems = [\n    11→  { key: \"educational\", href: \"/educational\" },\n    12→  { key: \"tournaments\", href: \"/tournaments\" },\n    13→  { key: \"training\", href: \"/training\" },\n    14→  { key: \"rankings\", href: \"/rankings\" },\n    15→  { key: \"bulkOrders\", href: \"/bulk-orders\" },\n    16→] as const;\n    17→\n    18→export function Header() {\n    19→  const t = useTranslations(\"nav\");\n    20→  const tAuth = useTranslations(\"auth\");\n    21→  const locale = useLocale();\n    22→  const [mobileMenuOpen, setMobileMenuOpen] = useState(false);\n    23→\n    24→  // TODO: Replace with actual auth state from Supabase\n    25→  const isAuthenticated = false;\n    26→\n    27→  return (\n    28→    <header className=\"sticky top-0 z-50 w-full border-b border-border/40 bg-background/95 backdrop-blur supports-[backdrop-filter]:bg-background/60\">\n    29→      <div className=\"container mx-auto flex h-16 items-center justify-between px-4\">\n    30→        {/* Logo */}\n    31→        <Link\n    32→          href={`/${locale}`}\n    33→          className=\"flex items-center gap-2 font-semibold text-lg\"\n    34→        >\n    35→          <span className=\"text-primary\">Roundnet</span>\n    36→          <span className=\"text-muted-foreground\">Spain</span>\n    37→        </Link>\n    38→\n    39→        {/* Desktop Navigation */}\n    40→        <nav className=\"hidden md:flex items-center gap-6\">\n    41→          {navItems.map((item) => (\n    42→            <Link\n    43→              key={item.key}\n    44→              href={`/${locale}${item.href}`}\n    45→              className=\"text-sm font-medium text-muted-foreground transition-colors hover:text-foreground\"\n    46→            >\n    47→              {t(item.key)}\n    48→            </Link>\n    49→          ))}\n    50→        </nav>\n    51→\n    52→        {/* Desktop Right Section */}\n    53→        <div className=\"hidden md:flex items-center gap-4\">\n    54→          <LanguageSwitcher />\n    55→\n    56→          {/* Auth Status */}\n    57→          {isAuthenticated ? (\n    58→            <Link\n    59→              href={`/${locale}/profile`}\n    60→              className=\"flex items-center gap-2 text-sm font-medium text-muted-foreground transition-colors hover:text-foreground\"\n    61→            >\n    62→              <User className=\"h-4 w-4\" />\n    63→              {tAuth(\"profile\")}\n    64→            </Link>\n    65→          ) : (\n    66→            <Link\n    67→              href={`/${locale}/login`}\n    68→              className=\"flex items-center gap-2 rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground transition-colors hover:bg-primary/90\"\n    69→            >\n    70→              <LogIn className=\"h-4 w-4\" />\n    71→              {tAuth(\"login\")}\n    72→            </Link>\n    73→          )}\n    74→        </div>\n    75→\n    76→        {/* Mobile Menu Button */}\n    77→        <button\n    78→          type=\"button\"\n    79→          className=\"md:hidden p-2 text-muted-foreground hover:text-foreground\"\n    80→          onClick={() => setMobileMenuOpen(!mobileMenuOpen)}\n    81→          aria-label={mobileMenuOpen ? t(\"closeMenu\") : t(\"menu\")}\n    82→          aria-expanded={mobileMenuOpen}\n    83→        >\n    84→          {mobileMenuOpen ? (\n    85→            <X className=\"h-6 w-6\" />\n    86→          ) : (\n    87→            <Menu className=\"h-6 w-6\" />\n    88→          )}\n    89→        </button>\n    90→      </div>\n    91→\n    92→      {/* Mobile Menu */}\n    93→      <div\n    94→        className={cn(\n    95→          \"md:hidden overflow-hidden transition-all duration-300 ease-in-out\",\n    96→          mobileMenuOpen ? \"max-h-[500px] border-t border-border/40\" : \"max-h-0\"\n    97→        )}\n    98→      >\n    99→        <nav className=\"container mx-auto px-4 py-4 space-y-4\">\n   100→          {navItems.map((item) => (\n   101→            <Link\n   102→              key={item.key}\n   103→              href={`/${locale}${item.href}`}\n   104→              className=\"block text-base font-medium text-muted-foreground transition-colors hover:text-foreground\"\n   105→              onClick={() => setMobileMenuOpen(false)}\n   106→            >\n   107→              {t(item.key)}\n   108→            </Link>\n   109→          ))}\n   110→\n   111→          <div className=\"pt-4 border-t border-border/40 space-y-4\">\n   112→            <div className=\"flex items-center justify-between\">\n   113→              <span className=\"text-sm text-muted-foreground\">\n   114→                {t(\"home\")}\n   115→              </span>\n   116→              <LanguageSwitcher />\n   117→            </div>\n   118→\n   119→            {/* Mobile Auth */}\n   120→            {isAuthenticated ? (\n   121→              <Link\n   122→                href={`/${locale}/profile`}\n   123→                className=\"flex items-center gap-2 text-base font-medium text-muted-foreground transition-colors hover:text-foreground\"\n   124→                onClick={() => setMobileMenuOpen(false)}\n   125→              >\n   126→                <User className=\"h-5 w-5\" />\n   127→                {tAuth(\"profile\")}\n   128→              </Link>\n   129→            ) : (\n   130→              <Link\n   131→                href={`/${locale}/login`}\n   132→                className=\"flex items-center justify-center gap-2 rounded-md bg-primary px-4 py-2.5 text-base font-medium text-primary-foreground transition-colors hover:bg-primary/90\"\n   133→                onClick={() => setMobileMenuOpen(false)}\n   134→              >\n   135→                <LogIn className=\"h-5 w-5\" />\n   136→                {tAuth(\"login\")}\n   137→              </Link>\n   138→            )}\n   139→          </div>\n   140→        </nav>\n   141→      </div>\n   142→    </header>\n   143→  );\n   144→}\n   145→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":"toolu_013BTMJWoZ4GKDKnzPu4S2wT","session_id":"b462f71f-cc96-4f44-b5a7-de6841443bc4","uuid":"71063829-2cfd-496f-85be-73d01bb588f9"}
