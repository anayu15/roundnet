{"type":"assistant","message":{"model":"claude-opus-4-5-20251101","id":"msg_01BUWqcXirsmp7ucLFziMURc","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01PCYufxuwwSigUVocG4MY1a","name":"Write","input":{"file_path":"/Users/anayusta/workspace/roundnet/src/components/login-form.tsx","content":"\"use client\";\n\nimport { useState } from \"react\";\nimport { useForm } from \"react-hook-form\";\nimport { zodResolver } from \"@hookform/resolvers/zod\";\nimport { z } from \"zod\";\nimport { useTranslations } from \"next-intl\";\nimport { Loader2 } from \"lucide-react\";\n\nimport { Button } from \"@/components/ui/button\";\nimport { Input } from \"@/components/ui/input\";\nimport {\n  Form,\n  FormControl,\n  FormField,\n  FormItem,\n  FormLabel,\n  FormMessage,\n} from \"@/components/ui/form\";\nimport { supabase } from \"@/lib/supabase\";\n\nconst createLoginSchema = (t: ReturnType<typeof useTranslations<\"login\">>) =>\n  z.object({\n    identifier: z.string().min(1, t(\"errors.identifierRequired\")),\n    password: z.string().min(1, t(\"errors.passwordRequired\")),\n  });\n\ntype LoginFormValues = z.infer<ReturnType<typeof createLoginSchema>>;\n\nfunction isEmail(value: string): boolean {\n  const emailRegex = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\n  return emailRegex.test(value);\n}\n\ninterface LoginFormProps {\n  onSuccess?: () => void;\n}\n\nexport function LoginForm({ onSuccess }: LoginFormProps) {\n  const t = useTranslations(\"login\");\n  const [isSubmitting, setIsSubmitting] = useState(false);\n  const [submitError, setSubmitError] = useState<string | null>(null);\n  const [submitSuccess, setSubmitSuccess] = useState<string | null>(null);\n\n  const schema = createLoginSchema(t);\n\n  const form = useForm<LoginFormValues>({\n    resolver: zodResolver(schema),\n    defaultValues: {\n      identifier: \"\",\n      password: \"\",\n    },\n    mode: \"onChange\",\n  });\n\n  const onSubmit = async (values: LoginFormValues) => {\n    setIsSubmitting(true);\n    setSubmitError(null);\n    setSubmitSuccess(null);\n\n    try {\n      let email = values.identifier;\n\n      // Check if the identifier is an email or username\n      if (!isEmail(values.identifier)) {\n        // It's a username - need to look up the email\n        const { data: profileData, error: profileError } = await supabase\n          .from(\"profiles\")\n          .select(\"id\")\n          .ilike(\"full_name\", values.identifier)\n          .maybeSingle();\n\n        if (profileError && profileError.code !== \"42P01\") {\n          setSubmitError(t(\"errors.genericError\"));\n          setIsSubmitting(false);\n          return;\n        }\n\n        if (!profileData) {\n          setSubmitError(t(\"errors.userNotFound\"));\n          setIsSubmitting(false);\n          return;\n        }\n\n        // Get the user's email from auth.users via the profile id\n        // Since we can't directly query auth.users from client, we use the placeholder email pattern\n        // The placeholder email format is: username@placeholder.local\n        email = `${values.identifier.toLowerCase().replace(/\\s+/g, \"_\")}@placeholder.local`;\n      }\n\n      // Attempt to sign in with email and password\n      const { error } = await supabase.auth.signInWithPassword({\n        email,\n        password: values.password,\n      });\n\n      if (error) {\n        if (error.message.includes(\"Invalid login credentials\")) {\n          setSubmitError(t(\"errors.invalidCredentials\"));\n        } else {\n          setSubmitError(error.message || t(\"errors.genericError\"));\n        }\n        return;\n      }\n\n      // Success\n      setSubmitSuccess(t(\"success\"));\n      form.reset();\n      onSuccess?.();\n    } catch {\n      setSubmitError(t(\"errors.genericError\"));\n    } finally {\n      setIsSubmitting(false);\n    }\n  };\n\n  const handleGoogleLogin = async () => {\n    setSubmitError(null);\n    try {\n      const { error } = await supabase.auth.signInWithOAuth({\n        provider: \"google\",\n        options: {\n          redirectTo: `${window.location.origin}/auth/callback`,\n        },\n      });\n\n      if (error) {\n        setSubmitError(error.message || t(\"errors.genericError\"));\n      }\n    } catch {\n      setSubmitError(t(\"errors.genericError\"));\n    }\n  };\n\n  return (\n    <Form {...form}>\n      <form onSubmit={form.handleSubmit(onSubmit)} className=\"space-y-6\">\n        <FormField\n          control={form.control}\n          name=\"identifier\"\n          render={({ field }) => (\n            <FormItem>\n              <FormLabel>{t(\"identifier\")}</FormLabel>\n              <FormControl>\n                <Input\n                  placeholder={t(\"identifierPlaceholder\")}\n                  {...field}\n                  autoComplete=\"username\"\n                />\n              </FormControl>\n              <FormMessage />\n            </FormItem>\n          )}\n        />\n\n        <FormField\n          control={form.control}\n          name=\"password\"\n          render={({ field }) => (\n            <FormItem>\n              <FormLabel>{t(\"password\")}</FormLabel>\n              <FormControl>\n                <Input\n                  type=\"password\"\n                  placeholder={t(\"passwordPlaceholder\")}\n                  {...field}\n                  autoComplete=\"current-password\"\n                />\n              </FormControl>\n              <FormMessage />\n            </FormItem>\n          )}\n        />\n\n        {submitError && (\n          <div className=\"rounded-md bg-destructive/10 p-3 text-sm text-destructive\">\n            {submitError}\n          </div>\n        )}\n\n        {submitSuccess && (\n          <div className=\"rounded-md bg-green-500/10 p-3 text-sm text-green-600 dark:text-green-400\">\n            {submitSuccess}\n          </div>\n        )}\n\n        <Button type=\"submit\" className=\"w-full\" disabled={isSubmitting}>\n          {isSubmitting ? (\n            <>\n              <Loader2 className=\"mr-2 h-4 w-4 animate-spin\" />\n              {t(\"submitting\")}\n            </>\n          ) : (\n            t(\"submit\")\n          )}\n        </Button>\n\n        <div className=\"relative\">\n          <div className=\"absolute inset-0 flex items-center\">\n            <span className=\"w-full border-t\" />\n          </div>\n          <div className=\"relative flex justify-center text-xs uppercase\">\n            <span className=\"bg-card px-2 text-muted-foreground\">\n              {t(\"orContinueWith\")}\n            </span>\n          </div>\n        </div>\n\n        <Button\n          type=\"button\"\n          variant=\"outline\"\n          className=\"w-full\"\n          onClick={handleGoogleLogin}\n        >\n          <svg className=\"mr-2 h-4 w-4\" viewBox=\"0 0 24 24\">\n            <path\n              fill=\"currentColor\"\n              d=\"M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z\"\n            />\n            <path\n              fill=\"currentColor\"\n              d=\"M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z\"\n            />\n            <path\n              fill=\"currentColor\"\n              d=\"M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z\"\n            />\n            <path\n              fill=\"currentColor\"\n              d=\"M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z\"\n            />\n          </svg>\n          {t(\"google\")}\n        </Button>\n      </form>\n    </Form>\n  );\n}\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":287,"cache_read_input_tokens":35000,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":287},"output_tokens":7,"service_tier":"standard"},"context_management":null},"parent_tool_use_id":null,"session_id":"6fb93add-4f2d-45be-b50f-ea5a97535704","uuid":"c88bc5ad-cd0a-44b4-89fc-4b8302ebf60d"}
