{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019gsqqhuyU812BYRtkyNdQC","type":"tool_result","content":"     1→\"use client\";\n     2→\n     3→import { useState, useEffect } from \"react\";\n     4→import Link from \"next/link\";\n     5→import { useRouter } from \"next/navigation\";\n     6→import { useLocale, useTranslations } from \"next-intl\";\n     7→import { Menu, X, User, LogIn, LogOut, Loader2 } from \"lucide-react\";\n     8→import { LanguageSwitcher } from \"./language-switcher\";\n     9→import { cn } from \"@/lib/utils\";\n    10→import { supabase } from \"@/lib/supabase\";\n    11→\n    12→const navItems = [\n    13→  { key: \"educational\", href: \"/educational\" },\n    14→  { key: \"tournaments\", href: \"/tournaments\" },\n    15→  { key: \"training\", href: \"/training\" },\n    16→  { key: \"rankings\", href: \"/rankings\" },\n    17→  { key: \"bulkOrders\", href: \"/bulk-orders\" },\n    18→] as const;\n    19→\n    20→export function Header() {\n    21→  const t = useTranslations(\"nav\");\n    22→  const tAuth = useTranslations(\"auth\");\n    23→  const locale = useLocale();\n    24→  const router = useRouter();\n    25→  const [mobileMenuOpen, setMobileMenuOpen] = useState(false);\n    26→  const [isAuthenticated, setIsAuthenticated] = useState(false);\n    27→  const [isLoading, setIsLoading] = useState(true);\n    28→  const [isLoggingOut, setIsLoggingOut] = useState(false);\n    29→\n    30→  useEffect(() => {\n    31→    const checkAuth = async () => {\n    32→      const { data: { user } } = await supabase.auth.getUser();\n    33→      setIsAuthenticated(!!user);\n    34→      setIsLoading(false);\n    35→    };\n    36→\n    37→    checkAuth();\n    38→\n    39→    const { data: { subscription } } = supabase.auth.onAuthStateChange((_event, session) => {\n    40→      setIsAuthenticated(!!session?.user);\n    41→    });\n    42→\n    43→    return () => subscription.unsubscribe();\n    44→  }, []);\n    45→\n    46→  const handleLogout = async () => {\n    47→    setIsLoggingOut(true);\n    48→    await supabase.auth.signOut();\n    49→    setIsAuthenticated(false);\n    50→    setIsLoggingOut(false);\n    51→    router.push(`/${locale}`);\n    52→  };\n    53→\n    54→  return (\n    55→    <header className=\"sticky top-0 z-50 w-full border-b border-border/40 bg-background/95 backdrop-blur supports-[backdrop-filter]:bg-background/60\">\n    56→      <div className=\"container mx-auto flex h-16 items-center justify-between px-4\">\n    57→        {/* Logo */}\n    58→        <Link\n    59→          href={`/${locale}`}\n    60→          className=\"flex items-center gap-2 font-semibold text-lg\"\n    61→        >\n    62→          <span className=\"text-primary\">Roundnet</span>\n    63→          <span className=\"text-muted-foreground\">Spain</span>\n    64→        </Link>\n    65→\n    66→        {/* Desktop Navigation */}\n    67→        <nav className=\"hidden md:flex items-center gap-6\">\n    68→          {navItems.map((item) => (\n    69→            <Link\n    70→              key={item.key}\n    71→              href={`/${locale}${item.href}`}\n    72→              className=\"text-sm font-medium text-muted-foreground transition-colors hover:text-foreground\"\n    73→            >\n    74→              {t(item.key)}\n    75→            </Link>\n    76→          ))}\n    77→        </nav>\n    78→\n    79→        {/* Desktop Right Section */}\n    80→        <div className=\"hidden md:flex items-center gap-4\">\n    81→          <LanguageSwitcher />\n    82→\n    83→          {/* Auth Status */}\n    84→          {isLoading ? (\n    85→            <Loader2 className=\"h-4 w-4 animate-spin text-muted-foreground\" />\n    86→          ) : isAuthenticated ? (\n    87→            <div className=\"flex items-center gap-3\">\n    88→              <Link\n    89→                href={`/${locale}/profile`}\n    90→                className=\"flex items-center gap-2 text-sm font-medium text-muted-foreground transition-colors hover:text-foreground\"\n    91→              >\n    92→                <User className=\"h-4 w-4\" />\n    93→                {tAuth(\"profile\")}\n    94→              </Link>\n    95→              <button\n    96→                onClick={handleLogout}\n    97→                disabled={isLoggingOut}\n    98→                className=\"flex items-center gap-2 text-sm font-medium text-muted-foreground transition-colors hover:text-foreground disabled:opacity-50\"\n    99→              >\n   100→                {isLoggingOut ? (\n   101→                  <Loader2 className=\"h-4 w-4 animate-spin\" />\n   102→                ) : (\n   103→                  <LogOut className=\"h-4 w-4\" />\n   104→                )}\n   105→                {tAuth(\"logout\")}\n   106→              </button>\n   107→            </div>\n   108→          ) : (\n   109→            <div className=\"flex items-center gap-2\">\n   110→              <Link\n   111→                href={`/${locale}/login`}\n   112→                className=\"flex items-center gap-2 text-sm font-medium text-muted-foreground transition-colors hover:text-foreground\"\n   113→              >\n   114→                <LogIn className=\"h-4 w-4\" />\n   115→                {tAuth(\"login\")}\n   116→              </Link>\n   117→              <Link\n   118→                href={`/${locale}/register`}\n   119→                className=\"flex items-center gap-2 rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground transition-colors hover:bg-primary/90\"\n   120→              >\n   121→                {tAuth(\"register\")}\n   122→              </Link>\n   123→            </div>\n   124→          )}\n   125→        </div>\n   126→\n   127→        {/* Mobile Menu Button */}\n   128→        <button\n   129→          type=\"button\"\n   130→          className=\"md:hidden p-2 text-muted-foreground hover:text-foreground\"\n   131→          onClick={() => setMobileMenuOpen(!mobileMenuOpen)}\n   132→          aria-label={mobileMenuOpen ? t(\"closeMenu\") : t(\"menu\")}\n   133→          aria-expanded={mobileMenuOpen}\n   134→        >\n   135→          {mobileMenuOpen ? (\n   136→            <X className=\"h-6 w-6\" />\n   137→          ) : (\n   138→            <Menu className=\"h-6 w-6\" />\n   139→          )}\n   140→        </button>\n   141→      </div>\n   142→\n   143→      {/* Mobile Menu */}\n   144→      <div\n   145→        className={cn(\n   146→          \"md:hidden overflow-hidden transition-all duration-300 ease-in-out\",\n   147→          mobileMenuOpen ? \"max-h-[500px] border-t border-border/40\" : \"max-h-0\"\n   148→        )}\n   149→      >\n   150→        <nav className=\"container mx-auto px-4 py-4 space-y-4\">\n   151→          {navItems.map((item) => (\n   152→            <Link\n   153→              key={item.key}\n   154→              href={`/${locale}${item.href}`}\n   155→              className=\"block text-base font-medium text-muted-foreground transition-colors hover:text-foreground\"\n   156→              onClick={() => setMobileMenuOpen(false)}\n   157→            >\n   158→              {t(item.key)}\n   159→            </Link>\n   160→          ))}\n   161→\n   162→          <div className=\"pt-4 border-t border-border/40 space-y-4\">\n   163→            <div className=\"flex items-center justify-between\">\n   164→              <span className=\"text-sm text-muted-foreground\">\n   165→                {t(\"home\")}\n   166→              </span>\n   167→              <LanguageSwitcher />\n   168→            </div>\n   169→\n   170→            {/* Mobile Auth */}\n   171→            {isLoading ? (\n   172→              <div className=\"flex justify-center\">\n   173→                <Loader2 className=\"h-5 w-5 animate-spin text-muted-foreground\" />\n   174→              </div>\n   175→            ) : isAuthenticated ? (\n   176→              <div className=\"flex flex-col gap-3\