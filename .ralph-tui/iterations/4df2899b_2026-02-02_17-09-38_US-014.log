h\": \"La contraseña debe tener al menos 8 caracteres\",\n      \"passwordsDoNotMatch\": \"Las contraseñas no coinciden\",\n      \"registrationFailed\": \"Error en el registro. Por favor, inténtalo de nuevo.\",\n      \"genericError\": \"Ha ocurrido un error. Por favor, inténtalo de nuevo.\"\n    }\n  },\n  \"footer\": {\n    \"rights\": \"Todos los derechos reservados\",\n    \"privacy\": \"Política de Privacidad\",\n    \"terms\": \"Términos de Servicio\",\n    \"contact\": \"Contacto\"\n  },\n  \"home\": {\n    \"title\": \"Para empezar, edita el archivo page.tsx.\",\n    \"description\": \"¿Buscas un punto de partida o más instrucciones? Dirígete a <templates>Plantillas</templates> o al centro de <learning>Aprendizaje</learning>.\",\n    \"templates\": \"Plantillas\",\n    \"learning\": \"Aprendizaje\",\n    \"deployNow\": \"Desplegar Ahora\",\n    \"documentation\": \"Documentación\"\n  },\n  \"profile\": {\n    \"title\": \"Mi Perfil\",\n    \"profileInfo\": \"Información del Perfil\",\n    \"username\": \"Nombre de Usuario\",\n    \"usernameNote\": \"El nombre de usuario no se puede cambiar. Contacta con un administrador si es necesario.\",\n    \"email\": \"Email\",\n    \"noEmail\": \"Sin email configurado\",\n    \"membershipStatus\": \"Estado de Membresía\",\n    \"memberStatusActive\": \"Miembro Activo\",\n    \"registrationDate\": \"Miembro Desde\",\n    \"updateEmail\": \"Actualizar Email\",\n    \"updateEmailDescription\": \"Cambia tu dirección de email. Se enviará un email de verificación a tu nueva dirección.\",\n    \"newEmail\": \"Nuevo Email\",\n    \"emailPlaceholder\": \"tu@email.com\",\n    \"emailVerificationNote\": \"Se enviará un email de verificación para confirmar el cambio\",\n    \"updateEmailButton\": \"Actualizar Email\",\n    \"emailUpdateSuccess\": \"Email de verificación enviado. Por favor, revisa tu bandeja de entrada.\",\n    \"changePassword\": \"Cambiar Contraseña\",\n    \"changePasswordDescription\": \"Actualiza tu contraseña para mantener tu cuenta segura.\",\n    \"currentPassword\": \"Contraseña Actual\",\n    \"currentPasswordPlaceholder\": \"Introduce tu contraseña actual\",\n    \"newPassword\": \"Nueva Contraseña\",\n    \"newPasswordPlaceholder\": \"Introduce tu nueva contraseña\",\n    \"confirmPassword\": \"Confirmar Nueva Contraseña\",\n    \"confirmPasswordPlaceholder\": \"Confirma tu nueva contraseña\",\n    \"passwordRequirements\": \"Mínimo 8 caracteres\",\n    \"changePasswordButton\": \"Cambiar Contraseña\",\n    \"passwordUpdateSuccess\": \"¡Contraseña cambiada con éxito!\",\n    \"updating\": \"Actualizando...\",\n    \"errors\": {\n      \"emailInvalid\": \"Por favor, introduce un email válido\",\n      \"currentPasswordRequired\": \"La contraseña actual es obligatoria\",\n      \"passwordMinLength\": \"La contraseña debe tener al menos 8 caracteres\",\n      \"confirmPasswordRequired\": \"Por favor, confirma tu nueva contraseña\",\n      \"passwordsDoNotMatch\": \"Las contraseñas no coinciden\",\n      \"notAuthenticated\": \"Debes iniciar sesión para actualizar tu perfil\",\n      \"currentPasswordInvalid\": \"La contraseña actual es incorrecta\",\n      \"noEmailForPasswordChange\": \"Se requiere un email para cambiar la contraseña\",\n      \"genericError\": \"Ha ocurrido un error. Por favor, inténtalo de nuevo.\"\n    }\n  },\n  \"metadata\": {\n    \"title\": \"Roundnet España\",\n    \"description\": \"Federación Española de Roundnet\"\n  }\n}\n","numLines":160,"startLine":1,"totalLines":160}}}
