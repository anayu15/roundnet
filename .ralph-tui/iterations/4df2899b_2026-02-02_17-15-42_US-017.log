{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01WziQSGgY2Kt9C6tXxyFwCb","type":"tool_result","content":"     1→\"use client\";\n     2→\n     3→import { useState, useEffect } from \"react\";\n     4→import { useRouter } from \"next/navigation\";\n     5→import { useForm } from \"react-hook-form\";\n     6→import { zodResolver } from \"@hookform/resolvers/zod\";\n     7→import { z } from \"zod\";\n     8→import { useLocale, useTranslations } from \"next-intl\";\n     9→import { Loader2, User, Mail, Calendar, Shield, Eye, EyeOff } from \"lucide-react\";\n    10→\n    11→import { Button } from \"@/components/ui/button\";\n    12→import { Input } from \"@/components/ui/input\";\n    13→import {\n    14→  Form,\n    15→  FormControl,\n    16→  FormDescription,\n    17→  FormField,\n    18→  FormItem,\n    19→  FormLabel,\n    20→  FormMessage,\n    21→} from \"@/components/ui/form\";\n    22→import { supabase } from \"@/lib/supabase\";\n    23→\n    24→type UserProfile = {\n    25→  id: string;\n    26→  full_name: string;\n    27→  email: string | null;\n    28→  created_at: string;\n    29→};\n    30→\n    31→const createEmailSchema = (t: ReturnType<typeof useTranslations<\"profile\">>) =>\n    32→  z.object({\n    33→    email: z.string().email(t(\"errors.emailInvalid\")),\n    34→  });\n    35→\n    36→const createPasswordSchema = (t: ReturnType<typeof useTranslations<\"profile\">>) =>\n    37→  z\n    38→    .object({\n    39→      currentPassword: z.string().min(1, t(\"errors.currentPasswordRequired\")),\n    40→      newPassword: z.string().min(8, t(\"errors.passwordMinLength\")),\n    41→      confirmPassword: z.string().min(1, t(\"errors.confirmPasswordRequired\")),\n    42→    })\n    43→    .refine((data) => data.newPassword === data.confirmPassword, {\n    44→      message: t(\"errors.passwordsDoNotMatch\"),\n    45→      path: [\"confirmPassword\"],\n    46→    });\n    47→\n    48→type EmailFormValues = z.infer<ReturnType<typeof createEmailSchema>>;\n    49→type PasswordFormValues = z.infer<ReturnType<typeof createPasswordSchema>>;\n    50→\n    51→export function ProfileContent() {\n    52→  const t = useTranslations(\"profile\");\n    53→  const locale = useLocale();\n    54→  const router = useRouter();\n    55→  const [isLoading, setIsLoading] = useState(true);\n    56→  const [profile, setProfile] = useState<UserProfile | null>(null);\n    57→  const [authEmail, setAuthEmail] = useState<string | null>(null);\n    58→\n    59→  // Email form state\n    60→  const [isEmailSubmitting, setIsEmailSubmitting] = useState(false);\n    61→  const [emailError, setEmailError] = useState<string | null>(null);\n    62→  const [emailSuccess, setEmailSuccess] = useState<string | null>(null);\n    63→\n    64→  // Password form state\n    65→  const [isPasswordSubmitting, setIsPasswordSubmitting] = useState(false);\n    66→  const [passwordError, setPasswordError] = useState<string | null>(null);\n    67→  const [passwordSuccess, setPasswordSuccess] = useState<string | null>(null);\n    68→  const [showCurrentPassword, setShowCurrentPassword] = useState(false);\n    69→  const [showNewPassword, setShowNewPassword] = useState(false);\n    70→  const [showConfirmPassword, setShowConfirmPassword] = useState(false);\n    71→\n    72→  const emailSchema = createEmailSchema(t);\n    73→  const passwordSchema = createPasswordSchema(t);\n    74→\n    75→  const emailForm = useForm<EmailFormValues>({\n    76→    resolver: zodResolver(emailSchema),\n    77→    defaultValues: {\n    78→      email: \"\",\n    79→    },\n    80→  });\n    81→\n    82→  const passwordForm = useForm<PasswordFormValues>({\n    83→    resolver: zodResolver(passwordSchema),\n    84→    defaultValues: {\n    85→      currentPassword: \"\",\n    86→      newPassword: \"\",\n    87→      confirmPassword: \"\",\n    88→    },\n    89→  });\n    90→\n    91→  useEffect(() => {\n    92→    const checkAuthAndLoadProfile = async () => {\n    93→      const { data: { user } } = await supabase.auth.getUser();\n    94→\n    95→      if (!user) {\n    96→        router.push(`/${locale}/login`);\n    97→        return;\n    98→      }\n    99→\n   100→      setAuthEmail(user.email || null);\n   101→\n   102→      const { data: profileData } = await supabase\n   103→        .from(\"profiles\")\n   104→        .select(\"id, full_name, email, created_at\")\n   105→        .eq(\"id\", user.id)\n   106→        .maybeSingle();\n   107→\n   108→      if (profileData) {\n   109→        setProfile(profileData);\n   110→        if (profileData.email) {\n   111→          emailForm.setValue(\"email\", profileData.email);\n   112→        }\n   113→      }\n   114→\n   115→      setIsLoading(false);\n   116→    };\n   117→\n   118→    checkAuthAndLoadProfile();\n   119→  }, [locale, router, emailForm]);\n   120→\n   121→  const onEmailSubmit = async (values: EmailFormValues) => {\n   122→    setIsEmailSubmitting(true);\n   123→    setEmailError(null);\n   124→    setEmailSuccess(null);\n   125→\n   126→    try {\n   127→      const { data: { user } } = await supabase.auth.getUser();\n   128→\n   129→      if (!user) {\n   130→        setEmailError(t(\"errors.notAuthenticated\"));\n   131→        return;\n   132→      }\n   133→\n   134→      // Update email in Supabase Auth (this sends verification email)\n   135→      const { error: authError } = await supabase.auth.updateUser({\n   136→        email: values.email,\n   137→      });\n   138→\n   139→      if (authError) {\n   140→        setEmailError(authError.message);\n   141→        return;\n   142→      }\n   143→\n   144→      // Update email in profiles table\n   145→      const { error: profileError } = await supabase\n   146→        .from(\"profiles\")\n   147→        .update({ email: values.email })\n   148→        .eq(\"id\", user.id);\n   149→\n   150→      if (profileError) {\n   151→        setEmailError(profileError.message);\n   152→        return;\n   153→      }\n   154→\n   155→      setEmailSuccess(t(\"emailUpdateSuccess\"));\n   156→      setProfile((prev) => prev ? { ...prev, email: values.email } : null);\n   157→    } catch {\n   158→      setEmailError(t(\"errors.genericError\"));\n   159→    } finally {\n   160→      setIsEmailSubmitting(false);\n   161→    }\n   162→  };\n   163→\n   164→  const onPasswordSubmit = async (values: PasswordFormValues) => {\n   165→    setIsPasswordSubmitting(true);\n   166→    setPasswordError(null);\n   167→    setPasswordSuccess(null);\n   168→\n   169→    try {\n   170→      const { data: { user } } = await supabase.auth.getUser();\n   171→\n   172→      if (!user) {\n   173→        setPasswordError(t(\"errors.notAuthenticated\"));\n   174→        return;\n   175→      }\n   176→\n   177→      // First verify the current password by attempting to sign in\n   178→      const email = authEmail || profile?.email;\n   179→      if (!email) {\n   180→        setPasswordError(t(\"errors.noEmailForPasswordChange\"));\n   181→        return;\n   182→      }\n   183→\n   184→      const { error: signInError } = await supabase.auth.signInWithPassword({\n   185→        email,\n   186→        password: values.currentPassword,\n   187→      });\n   188→\n   189→      if (signInError) {\n   190→        setPasswordError(t(\"errors.currentPasswordInvalid\"));\n   191→        return;\n   192→      }\n   193→\n   194→      // Update password\n   195→      const { error: updateError } = await supabase.auth.updateUser({\n   196→        password: values.newPassword,\n   197→      });\n   198→\n   199→      if (updateError) {\n   200→        setPasswordError(updateError.message);\n   201→        return;\n   202→      }\n   203→\n   204→      setPasswordSuccess(t(\"passwordUpdateSuccess\"));\n   205→      passwordForm.reset();\n   206→    } catch {\n   207→      setPasswordError(t(\"errors.genericError\"));\n   208→    } finally {\n   209→      setIsPasswordSubmitting(false);\n   210→    }\n   211→  };\n   212→\n   213→  const formatDate = (dateString: string) => {\n   214→    return new Date(dateString).toLocaleDateString(locale === \"es\" ? \"es-ES\" : \"en-US\", {\n   215→      year: \"numeric\",\n   216→      month: \"long\",\n   217→      day: \"numeric\",\n   218→    });\n   219→  };\n   220→\n   221→  if (isLoading) {\n   222→    return (\n   223→      <div className=\"flex min-h-[calc(100vh-8rem)] items-center justify-center\">\n   224→        <Loader2 className=\"h-8 w-8 animate-spin text-muted-foreground\" />\n   225→      </div>\n   226→    );\n   227→  }\n   228→\n   229→  return (\n   230→    <div className=\"container mx-auto px-4 py-8 max-w-2xl\">\n   231→      <h1 className=\"text-3xl font-bold tracking-tight mb-8\">{t(\"title\")}</h1>\n   232→\n   233→      {/* Profile Information Card */}\n   234→      <div className=\"rounded-lg border bg-card p-6 shadow-sm mb-6\">\n   235→        <h2 className=\"text-xl font-semibold mb-4\">{t(\"profileInfo\")}</h2>\n   236→\n   237→        <div className=\"space-y-4\">\n   238→          {/* Username */}\n   239→          <div className=\"flex items-start gap-3\">\n   240→            <User className=\"h-5 w-5 text-muted-foreground mt-0.5\" />\n   241→            <div>\n   242→              <p className=\"text-sm font-medium text-muted-foreground\">{t(\"username\")}</p>\n   243→              <p className=\"text-base\">{profile?.full_name}</p>\n   244→              <p className=\"text-xs text-muted-foreground mt-1\">{t(\"usernameNote\")}</p>\n   245→            </div>\n   246→          </div>\n   247→\n   248→          {/* Email */}\n   249→          <div className=\"flex items-start gap-3\">\n   250→            <Mail className=\"h-5 w-5 text-muted-foreground mt-0.5\" />\n   251→            <div>\n   252→              <p className=\"text-sm font-medium text-muted-foreground\">{t(\"email\")}</p>\n   253→              <p className=\"text-base\">{profile?.email || authEmail || t(\"noEmail\")}</p>\n   254→            </div>\n   255→          </div>\n   256→\n   257→          {/* Membership Status */}\n   258→          <div className=\"flex items-start gap-3\">\n   259→            <Shield className=\"h-5 w-5 text-muted-foreground mt-0.5\" />\n   260→            <div>\n   261→              <p className=\"text-sm font-medium text-muted-foreground\">{t(\"membershipStatus\")}</p>\n   262→              <p className=\"text-base\">{t(\"memberStatusActive\")}</p>\n   263→            </div>\n   264→          </div>\n   265→\n   266→          {/* Registration Date */}\n   267→          <div className=\"flex items-start gap-3\">\n   268→            <Calendar className=\"h-5 w-5 text-muted-foreground mt-0.5\" />\n   269→            <div>\n   270→              <p className=\"text-sm font-medium text-muted-foreground\">{t(\"registrationDate\")}</p>\n   271→              <p className=\"text-base\">{profile?.created_at ? formatDate(profile.created_at) : \"-\"}</p>\n   272→            </div>\n   273→          </div>\n   274→        </div>\n   275→      </div>\n   276→\n   277→      {/* Update Email Card */}\n   278→      <div className=\"rounded-lg border bg-card p-6 shadow-sm mb-6\">\n   279→        <h2 className=\"text-xl font-semibold mb-4\">{t(\"updateEmail\")}</h2>\n   280→        <p className=\"text-sm text-muted-foreground mb-4\">{t(\"updateEmailDescription\")}</p>\n   281→\n   282→        <Form {...emailForm}>\n   283→          <form onSubmit={emailForm.handleSubmit(onEmailSubmit)} className=\"space-y-4\">\n   284→            <FormField\n   285→              control={emailForm.control}\n   286→              name=\"email\"\n   287→              render={({ field }) => (\n   288→                <FormItem>\n   289→                  <FormLabel>{t(\"newEmail\")}</FormLabel>\n   290→                  <FormControl>\n   291→                    <Input\n   292→                      type=\"email\"\n   293→                      placeholder={t(\"emailPlaceholder\")}\n   294→                      {...field}\n   295→                    />\n   296→                  </FormControl>\n   297→                  <FormDescription>{t(\"emailVerificationNote\")}</FormDescription>\n   298→                  <FormMessage />\n   299→                </FormItem>\n   300→              )}\n   301→            />\n   302→\n   303→            {emailError && (\n   304→              <div className=\"rounded-md bg-destructive/10 p-3 text-sm text-destructive\">\n   305→                {emailError}\n   306→              </div>\n   307→            )}\n   308→\n   309→            {emailSuccess && (\n   310→              <div className=\"rounded-md bg-green-500/10 p-3 text-sm text-green-600 dark:text-green-400\">\n   311→                {emailSuccess}\n   312→              </div>\n   313→            )}\n   314→\n   315→            <Button type=\"submit\" disabled={isEmailSubmitting}>\n   316→              {isEmailSubmitting ? (\n   317→                <>\n   318→                  <Loader2 className=\"mr-2 h-4 w-4 animate-spin\" />\n   319→                  {t(\"updating\")}\n   320→                </>\n   321→              ) : (\n   322→                t(\"updateEmailButton\")\n   323→              )}\n   324→            </Button>\n   325→          </form>\n   326→        </Form>\n   327→      </div>\n   328→\n   329→      {/* Change Password Card */}\n   330→      <div className=\"rounded-lg border bg-card p-6 shadow-sm\">\n   331→        <h2 className=\"text-xl font-semibold mb-4\">{t(\"changePassword\")}</h2>\n   332→        <p className=\"text-sm text-muted-foreground mb-4\">{t(\"changePasswordDescription\")}</p>\n   333→\n   334→        <Form {...passwordForm}>\n   335→          <form onSubmit={passwordForm.handleSubmit(onPasswordSubmit)} className=\"space-y-4\">\n   336→            <FormField\n   337→              control={passwordForm.control}\n   338→              name=\"currentPassword\"\n   339→              render={({ field }) => (\n   340→                <FormItem>\n   341→                  <FormLabel>{t(\"currentPassword\")}</FormLabel>\n   342→                  <FormControl>\n   343→                    <div className=\"relative\">\n   344→                      <Input\n   345→                        type={showCurrentPassword ? \"text\" : \"password\"}\n   346→                        placeholder={t(\"currentPasswordPlaceholder\")}\n   347→                        {...field}\n   348→                      />\n   349→                      <button\n   350→                        type=\"button\"\n   351→                        className=\"absolute right-3 top-1/2 -translate-y-1/2 text-muted-foreground hover:text-foreground\"\n   352→                        onClick={() => setShowCurrentPassword(!showCurrentPassword)}\n   353→                        tabIndex={-1}\n   354→                      >\n   355→                        {showCurrentPassword ? (\n   356→                          <EyeOff className=\"h-4 w-4\" />\n   357→                        ) : (\n   358→                          <Eye className=\"h-4 w-4\" />\n   359→                        )}\n   360→                      </button>\n   361→                    </div>\n   362→                  </FormControl>\n   363→                  <FormMessage />\n   364→                </FormItem>\n   365→              )}\n   366→            />\n   367→\n   368→            <FormField\n   369→              control={passwordForm.control}\n   370→              name=\"newPassword\"\n   371→              render={({ field }) => (\n   372→                <FormItem>\n   373→                  <FormLabel>{t(\"newPassword\")}</FormLabel>\n   374→                  <FormControl>\n   375→                    <div className=\"relative\">\n   376→                      <Input\n   377→                        type={showNewPassword ? \"text\" : \"password\"}\n   378→                        placeholder={t(\"newPasswordPlaceholder\")}\n   379→                        {...field}\n   380→                      />\n   381→                      <button\n   382→                        type=\"button\"\n   383→                        className=\"absolute right-3 top-1/2 -translate-y-1/2 text-muted-foreground hover:text-foreground\"\n   384→                        onClick={() => setShowNewPassword(!showNewPassword)}\n   385→                        tabIndex={-1}\n   386→                      >\n   387→                        {showNewPassword ? (\n   388→                          <EyeOff className=\"h-4 w-4\" />\n   389→                        ) : (\n   390→                          <Eye className=\"h-4 w-4\" />\n   391→                        )}\n   392→                      </button>\n   393→                    </div>\n   394→                  </FormControl>\n   395→                  <FormDescription>{t(\"passwordRequirements\")}</FormDescription>\n   396→                  <FormMessage />\n   397→                </FormItem>\n   398→              )}\n   399→            />\n   400→\n   401→            <FormField\n   402→              control={passwordForm.control}\n   403→              name=\"confirmPassword\"\n   404→              render={({ field }) => (\n   405→                <FormItem>\n   406→                  <FormLabel>{t(\"confirmPassword\")}</FormLabel>\n   407→                  <FormControl>\n   408→                    <div className=\"relative\">\n   409→                      <Input\n   410→                        type={showConfirmPassword ? \"text\" : \"password\"}\n   411→                        placeholder={t(\"confirmPasswordPlaceholder\")}\n   412→                        {...field}\n   413→                      />\n   414→                      <button\n   415→                        type=\"button\"\n   416→                        className=\"absolute right-3 top-1/2 -translate-y-1/2 text-muted-foreground hover:text-foreground\"\n   417→                        onClick={() => setShowConfirmPassword(!showConfirmPassword)}\n   418→                        tabIndex={-1}\n   419→                      >\n   420→                        {showConfirmPassword ? (\n   421→                          <EyeOff className=\"h-4 w-4\" />\n   422→                        ) : (\n   423→                          <Eye className=\"h-4 w-4\" />\n   424→                        )}\n   425→                      </button>\n   426→                    </div>\n   427→                  </FormControl>\n   428→                  <FormMessage />\n   429→                </FormItem>\n   430→              )}\n   431→            />\n   432→\n   433→            {passwordError && (\n   434→              <div className=\"rounded-md bg-destructive/10 p-3 text-sm text-destructive\">\n   435→                {passwordError}\n   436→              </div>\n   437→            )}\n   438→\n   439→            {passwordSuccess && (\n   440→              <div className=\"rounded-md bg-green-500/10 p-3 text-sm text-green-600 dark:text-green-400\">\n   441→                {passwordSuccess}\n   442→              </div>\n   443→            )}\n   444→\n   445→            <Button type=\"submit\" disabled={isPasswordSubmitting}>\n   446→              {isPasswordSubmitting ? (\n   447→                <>\n   448→                  <Loader2 className=\"mr-2 h-4 w-4 animate-spin\" />\n   449→                  {t(\"updating\")}\n   450→                </>\n   451→              ) : (\n   452→                t(\"changePasswordButton\")\n   453→              )}\n   454→            </Button>\n   455→          </form>\n   456→        </Form>\n   457→      </div>\n   458→    </div>\n   459→  );\n   460→}\n   461→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"dd558466-241e-4005-8014-18e5732e4b3e","uuid":"630fb7b9-04ae-48c7-bdfc-418ad552ee07","tool_use_result":{"type":"text","file":{"filePath":"/Users/anayusta/workspace/roundnet/src/app/[locale]/profile/profile-content.tsx","content":"\"use client\";\n\nimport { useState, useEffect } from \"react\";\nimport { useRouter } from \"next/navigation\";\nimport { useForm } from \"react-hook-form\";\nimport { zodResolver } from \"@hookform/resolvers/zod\";\nimport { z } from \"zod\";\nimport { useLocale, useTranslations } from \"next-intl\";\nimport { Loader2, User, Mail, Calendar, Shield, Eye, EyeOff } from \"lucide-react\";\n\nimport { Button } from \"@/components/ui/button\";\nimport { Input } from \"@/components/ui/input\";\nimport {\n  Form,\n  FormControl,\n  FormDescription,\n  FormField,\n  FormItem,\n  FormLabel,\n  FormMessage,\n} from \"@/components/ui/form\";\nimport { supabase } from \"@/lib/supabase\";\n\ntype UserProfile = {\n  id: string;\n  full_name: string;\n  email: string | null;\n  created_at: string;\n};\n\nconst createEmailSchema = (t: ReturnType<typeof useTranslations<\"profile\">>) =>\n  z.object({\n    email: z.string().email(t(\"errors.emailInvalid\")),\n  });\n\nconst createPasswordSchema = (t: ReturnType<typeof useTranslations<\"profile\">>) =>\n  z\n    .object({\n      currentPassword: z.string().min(1, t(\"errors.currentPasswordRequired\")),\n      newPassword: z.string().min(8, t(\"errors.passwordMinLength\")),\n      confirmPassword: z.string().min(1, t(\"errors.confirmPasswordRequired\")),\n    })\n    .refine((data) => data.newPassword === data.confirmPassword, {\n      message: t(\"errors.passwordsDoNotMatch\"),\n      path: [\"confirmPassword\"],\n    });\n\ntype EmailFormValues = z.infer<ReturnType<typeof createEmailSchema>>;\ntype PasswordFormValues = z.infer<ReturnType<typeof createPasswordSchema>>;\n\nexport function ProfileContent() {\n  const t = useTranslations(\"profile\");\n  const locale = useLocale();\n  const router = useRouter();\n  const [isLoading, setIsLoading] = useState(true);\n  const [profile, setProfile] = useState<UserProfile | null>(null);\n  const [authEmail, setAuthEmail] = useState<string | null>(null);\n\n  // Email form state\n  const [isEmailSubmitting, setIsEmailSubmitting] = useState(false);\n  const [emailError, setEmailError] = useState<string | null>(null);\n  const [emailSuccess, setEmailSuccess] = useState<string | null>(null);\n\n  // Password form state\n  const [isPasswordSubmitting, setIsPasswordSubmitting] = useState(false);\n  const [passwordError, setPasswordError] = useState<string | null>(null);\n  const [passwordSuccess, setPasswordSuccess] = useState<string | null>(null);\n  const [showCurrentPassword, setShowCurrentPassword] = useState(false);\n  const [showNewPassword, setShowNewPassword] = useState(false);\n  const [showConfirmPassword, setShowConfirmPassword] = useState(false);\n\n  const emailSchema = createEmailSchema(t);\n  const passwordSchema = createPasswordSchema(t);\n\n  const emailForm = useForm<EmailFormValues>({\n    resolver: zodResolver(emailSchema),\n    defaultValues: {\n      email: \"\",\n    },\n  });\n\n  const passwordForm = useForm<PasswordFormValues>({\n    resolver: zodResolver(passwordSchema),\n    defaultValues: {\n      currentPassword: \"\",\n      newPassword: \"\",\n      confirmPassword: \"\",\n    },\n  });\n\n  useEffect(() => {\n    const checkAuthAndLoadProfile = async () => {\n      const { data: { user } } = await supabase.auth.getUser();\n\n      if (!user) {\n        router.push(`/${locale}/login`);\n        return;\n      }\n\n      setAuthEmail(user.email || null);\n\n      const { data: profileData } = await supabase\n        .from(\"profiles\")\n        .select(\"id, full_name, email, created_at\")\n        .eq(\"id\", user.id)\n        .maybeSingle();\n\n      if (profileData) {\n        setProfile(profileData);\n        if (profileData.email) {\n          emailForm.setValue(\"email\", profileData.email);\n        }\n      }\n\n      setIsLoading(false);\n    };\n\n    checkAuthAndLoadProfile();\n  }, [locale, router, emailForm]);\n\n  const onEmailSubmit = async (values: EmailFormValues) => {\n    setIsEmailSubmitting(true);\n    setEmailError(null);\n    setEmailSuccess(null);\n\n    try {\n      const { data: { user } } = await supabase.auth.getUser();\n\n      if (!user) {\n        setEmailError(t(\"errors.notAuthenticated\"));\n        return;\n      }\n\n      // Update email in Supabase Auth (this sends verification email)\n      const { error: authError } = await supabase.auth.updateUser({\n        email: values.email,\n      });\n\n      if (authError) {\n        setEmailError(authError.message);\n        return;\n      }\n\n      // Update email in profiles table\n      const { error: profileError } = await supabase\n        .from(\"profiles\")\n        .update({ email: values.email })\n        .eq(\"id\", user.id);\n\n      if (profileError) {\n        setEmailError(profileError.message);\n        return;\n      }\n\n      setEmailSuccess(t(\"emailUpdateSuccess\"));\n      setProfile((prev) => prev ? { ...prev, email: values.email } : null);\n    } catch {\n      setEmailError(t(\"errors.genericError\"));\n    } finally {\n      setIsEmailSubmitting(false);\n    }\n  };\n\n  const onPasswordSubmit = async (values: PasswordFormValues) => {\n    setIsPasswordSubmitting(true);\n    setPasswordError(null);\n    setPasswordSuccess(null);\n\n    try {\n      const { data: { user } } = await supabase.auth.getUser();\n\n      if (!user) {\n        setPasswordError(t(\"errors.notAuthenticated\"));\n        return;\n      }\n\n      // First verify the current password by attempting to sign in\n      const email = authEmail || profile?.email;\n      if (!email) {\n        setPasswordError(t(\"errors.noEmailForPasswordChange\"));\n        return;\n      }\n\n      const { error: signInError } = await supabase.auth.signInWithPassword({\n        email,\n        password: values.currentPassword,\n      });\n\n      if (signInError) {\n        setPasswordError(t(\"errors.currentPasswordInvalid\"));\n        return;\n      }\n\n      // Update password\n      const { error: updateError } = await supabase.auth.updateUser({\n        password: values.newPassword,\n      });\n\n      if (updateError) {\n        setPasswordError(updateError.message);\n        return;\n      }\n\n      setPasswordSuccess(t(\"passwordUpdateSuccess\"));\n      passwordForm.reset();\n    } catch {\n      setPasswordError(t(\"errors.genericError\"));\n    } finally {\n      setIsPasswordSubmitting(false);\n    }\n  };\n\n  const formatDate = (dateString: string) => {\n    return new Date(dateString).toLocaleDateString(locale === \"es\" ? \"es-ES\" : \"en-US\", {\n      year: \"numeric\",\n      month: \"long\",\n      day: \"numeric\",\n    });\n  };\n\n  if (isLoading) {\n    return (\n      <div className=\"flex min-h-[calc(100vh-8rem)] items-center justify-center\">\n        <Loader2 className=\"h-8 w-8 animate-spin text-muted-foreground\" />\n      </div>\n    );\n  }\n\n  return (\n    <div className=\"container mx-auto px-4 py-8 max-w-2xl\">\n      <h1 className=\"text-3xl font-bold tracking-tight mb-8\">{t(\"title\")}</h1>\n\n      {/* Profile Information Card */}\n      <div className=\"rounded-lg border bg-card p-6 shadow-sm mb-6\">\n        <h2 className=\"text-xl font-semibold mb-4\">{t(\"profileInfo\")}</h2>\n\n        <div className=\"space-y-4\">\n          {/* Username */}\n          <div className=\"flex items-start gap-3\">\n            <User className=\"h-5 w-5 text-muted-foreground mt-0.5\" />\n            <div>\n              <p className=\"text-sm font-medium text-muted-foreground\">{t(\"username\")}</p>\n              <p className=\"text-base\">{profile?.full_name}</p>\n              <p className=\"text-xs text-muted-foreground mt-1\">{t(\"usernameNote\")}</p>\n            </div>\n          </div>\n\n          {/* Email */}\n          <div className=\"flex items-start gap-3\">\n            <Mail className=\"h-5 w-5 text-muted-foreground mt-0.5\" />\n            <div>\n              <p className=\"text-sm font-medium text-muted-foreground\">{t(\"email\")}</p>\n              <p className=\"text-base\">{profile?.email || authEmail || t(\"noEmail\")}</p>\n            </div>\n          </div>\n\n          {/* Membership Status */}\n          <div className=\"flex items-start gap-3\">\n            <Shield className=\"h-5 w-5 text-muted-foreground mt-0.5\" />\n            <div>\n              <p className=\"text-sm font-medium text-muted-foreground\">{t(\"membershipStatus\")}</p>\n              <p className=\"text-base\">{t(\"memberStatusActive\")}</p>\n            </div>\n          </div>\n\n          {/* Registration Date */}\n          <div className=\"flex items-start gap-3\">\n            <Calendar className=\"h-5 w-5 text-muted-foreground mt-0.5\" />\n            <div>\n              <p className=\"text-sm font-medium text-muted-foreground\">{t(\"registrationDate\")}</p>\n              <p className=\"text-base\">{profile?.created_at ? formatDate(profile.created_at) : \"-\"}</p>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      {/* Update Email Card */}\n      <div className=\"rounded-lg border bg-card p-6 shadow-sm mb-6\">\n        <h2 className=\"text-xl font-semibold mb-4\">{t(\"updateEmail\")}</h2>\n        <p className=\"text-sm text-muted-foreground mb-4\">{t(\"updateEmailDescription\")}</p>\n\n        <Form {...emailForm}>\n          <form onSubmit={emailForm.handleSubmit(onEmailSubmit)} className=\"space-y-4\">\n            <FormField\n              control={emailForm.control}\n              name=\"email\"\n              render={({ field }) => (\n                <FormItem>\n                  <FormLabel>{t(\"newEmail\")}</FormLabel>\n                  <FormControl>\n                    <Input\n                      type=\"email\"\n                      placeholder={t(\"emailPlaceholder\")}\n                      {...field}\n                    />\n                  </FormControl>\n                  <FormDescription>{t(\"emailVerificationNote\")}</FormDescription>\n                  <FormMessage />\n                </FormItem>\n              )}\n            />\n\n            {emailError && (\n              <div className=\"rounded-md bg-destructive/10 p-3 text-sm text-destructive\">\n                {emailError}\n              </div>\n            )}\n\n            {emailSuccess && (\n              <div className=\"rounded-md bg-green-500/10 p-3 text-sm text-green-600 dark:text-green-400\">\n                {emailSuccess}\n              </div>\n            )}\n\n            <Button type=\"submit\" disabled={isEmailSubmitting}>\n              {isEmailSubmitting ? (\n                <>\n                  <Loader2 className=\"mr-2 h-4 w-4 animate-spin\" />\n                  {t(\"updating\")}\n                </>\n              ) : (\n                t(\"updateEmailButton\")\n              )}\n            </Button>\n          </form>\n        </Form>\n      </div>\n\n      {/* Change Password Card */}\n      <div className=\"rounded-lg border bg-card p-6 shadow-sm\">\n        <h2 className=\"text-xl font-semibold mb-4\">{t(\"changePassword\")}</h2>\n        <p className=\"text-sm text-muted-foreground mb-4\">{t(\"changePasswordDescription\")}</p>\n\n        <Form {...passwordForm}>\n          <form onSubmit={passwordForm.handleSubmit(onPasswordSubmit)} className=\"space-y-4\">\n            <FormField\n              control={passwordForm.control}\n              name=\"currentPassword\"\n              render={({ field }) => (\n                <FormItem>\n                  <FormLabel>{t(\"currentPassword\")}</FormLabel>\n                  <FormControl>\n                    <div className=\"relative\">\n                      <Input\n                        type={showCurrentPassword ? \"text\" : \"password\"}\n                        placeholder={t(\"currentPasswordPlaceholder\")}\n                        {...field}\n                      />\n                      <button\n                        type=\"button\"\n                        className=\"absolute right-3 top-1/2 -translate-y-1/2 text-muted-foreground hover:text-foreground\"\n                        onClick={() => setShowCurrentPassword(!showCurrentPassword)}\n                        tabIndex={-1}\n                      >\n                        {showCurrentPassword ? (\n                          <EyeOff className=\"h-4 w-4\" />\n                        ) : (\n                          <Eye className=\"h-4 w-4\" />\n                        )}\n                      </button>\n                    </div>\n                  </FormControl>\n                  <FormMessage />\n                </FormItem>\n              )}\n            />\n\n            <FormField\n              control={passwordForm.control}\n              name=\"newPassword\"\n              render={({ field }) => (\n                <FormItem>\n                  <FormLabel>{t(\"newPassword\")}</FormLabel>\n                  <FormControl>\n                    <div className=\"relative\">\n                      <Input\n                        type={showNewPassword ? \"text\" : \"password\"}\n                        placeholder={t(\"newPasswordPlaceholder\")}\n                        {...field}\n                      />\n                      <button\n                        type=\"button\"\n                        className=\"absolute right-3 top-1/2 -translate-y-1/2 text-muted-foreground hover:text-foreground\"\n                        onClick={() => setShowNewPassword(!showNewPassword)}\n                        tabIndex={-1}\n                      >\n                        {showNewPassword ? (\n                          <EyeOff className=\"h-4 w-4\" />\n                        ) : (\n                          <Eye className=\"h-4 w-4\" />\n                        )}\n                      </button>\n                    </div>\n                  </FormControl>\n                  <FormDescription>{t(\"passwordRequirements\")}</FormDescription>\n                  <FormMessage />\n                </FormItem>\n              )}\n            />\n\n            <FormField\n              control={passwordForm.control}\n              name=\"confirmPassword\"\n              render={({ field }) => (\n                <FormItem>\n                  <FormLabel>{t(\"confirmPassword\")}</FormLabel>\n                  <FormControl>\n                    <div className=\"relative\">\n                      <Input\n                        type={showConfirmPassword ? \"text\" : \"password\"}\n                        placeholder={t(\"confirmPasswordPlaceholder\")}\n                        {...field}\n                      />\n                      <button\n                        type=\"button\"\n                        className=\"absolute right-3 top-1/2 -translate-y-1/2 text-muted-foreground hover:text-foreground\"\n                        onClick={() => setShowConfirmPassword(!showConfirmPassword)}\n                        tabIndex={-1}\n                      >\n                        {showConfirmPassword ? (\n                          <EyeOff className=\"h-4 w-4\" />\n                        ) : (\n                          <Eye className=\"h-4 w-4\" />\n                        )}\n                      </button>\n                    </div>\n                  </FormControl>\n                  <FormMessage />\n                </FormItem>\n              )}\n            />\n\n            {passwordError && (\n              <div className=\"rounded-md bg-destructive/10 p-3 text-sm text-destructive\">\n                {passwordError}\n              </div>\n            )}\n\n            {passwordSuccess && (\n              <div className=\"rounded-md bg-green-500/10 p-3 text-sm text-green-600 dark:text-green-400\">\n                {passwordSuccess}\n              </div>\n            )}\n\n            <Button type=\"submit\" disabled={isPasswordSubmitting}>\n              {isPasswordSubmitting ? (\n                <>\n                  <Loader2 className=\"mr-2 h-4 w-4 animate-spin\" />\n                  {t(\"updating\")}\n                </>\n              ) : (\n                t(\"changePasswordButton\")\n              )}\n            </Button>\n          </form>\n        </Form>\n      </div>\n    </div>\n  );\n}\n","numLines":461,"startLine":1,"totalLines":461}}}
