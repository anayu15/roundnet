{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01NKy9wDLHdGCFJpJGucMNPu","type":"tool_result","content":"     1→\"use client\";\n     2→\n     3→import { useState, useEffect, useCallback } from \"react\";\n     4→import { useRouter } from \"next/navigation\";\n     5→import { useForm } from \"react-hook-form\";\n     6→import { zodResolver } from \"@hookform/resolvers/zod\";\n     7→import { z } from \"zod\";\n     8→import { useLocale, useTranslations } from \"next-intl\";\n     9→import { CheckCircle, XCircle, Loader2 } from \"lucide-react\";\n    10→\n    11→import { Button } from \"@/components/ui/button\";\n    12→import { Input } from \"@/components/ui/input\";\n    13→import {\n    14→  Form,\n    15→  FormControl,\n    16→  FormDescription,\n    17→  FormField,\n    18→  FormItem,\n    19→  FormLabel,\n    20→  FormMessage,\n    21→} from \"@/components/ui/form\";\n    22→import { cn } from \"@/lib/utils\";\n    23→import { supabase } from \"@/lib/supabase\";\n    24→\n    25→const createUsernameSchema = (t: ReturnType<typeof useTranslations<\"completeProfile\">>) =>\n    26→  z.object({\n    27→    username: z\n    28→      .string()\n    29→      .min(1, t(\"errors.usernameRequired\"))\n    30→      .min(2, t(\"errors.usernameMinLength\"))\n    31→      .max(100, t(\"errors.usernameMaxLength\")),\n    32→  });\n    33→\n    34→type UsernameFormValues = z.infer<ReturnType<typeof createUsernameSchema>>;\n    35→\n    36→type UsernameStatus = \"idle\" | \"checking\" | \"available\" | \"taken\";\n    37→\n    38→export function CompleteProfileContent() {\n    39→  const t = useTranslations(\"completeProfile\");\n    40→  const locale = useLocale();\n    41→  const router = useRouter();\n    42→  const [isSubmitting, setIsSubmitting] = useState(false);\n    43→  const [submitError, setSubmitError] = useState<string | null>(null);\n    44→  const [usernameStatus, setUsernameStatus] = useState<UsernameStatus>(\"idle\");\n    45→  const [isLoading, setIsLoading] = useState(true);\n    46→  const [userEmail, setUserEmail] = useState<string | null>(null);\n    47→\n    48→  const schema = createUsernameSchema(t);\n    49→\n    50→  const form = useForm<UsernameFormValues>({\n    51→    resolver: zodResolver(schema),\n    52→    defaultValues: {\n    53→      username: \"\",\n    54→    },\n    55→    mode: \"onChange\",\n    56→  });\n    57→\n    58→  const usernameValue = form.watch(\"username\");\n    59→\n    60→  // Check if user is authenticated and needs to set username\n    61→  useEffect(() => {\n    62→    const checkAuth = async () => {\n    63→      const { data: { user } } = await supabase.auth.getUser();\n    64→\n    65→      if (!user) {\n    66→        // Not authenticated, redirect to login\n    67→        router.push(`/${locale}/login`);\n    68→        return;\n    69→      }\n    70→\n    71→      // Check if user already has a profile with username\n    72→      const { data: profile } = await supabase\n    73→        .from(\"profiles\")\n    74→        .select(\"full_name\")\n    75→        .eq(\"id\", user.id)\n    76→        .maybeSingle();\n    77→\n    78→      if (profile?.full_name) {\n    79→        // User already has a username, redirect to home\n    80→        router.push(`/${locale}`);\n    81→        return;\n    82→      }\n    83→\n    84→      setUserEmail(user.email || null);\n    85→      setIsLoading(false);\n    86→    };\n    87→\n    88→    checkAuth();\n    89→  }, [locale, router]);\n    90→\n    91→  const checkUsernameAvailability = useCallback(\n    92→    async (username: string) => {\n    93→      if (!username || username.length < 2) {\n    94→        setUsernameStatus(\"idle\");\n    95→        return;\n    96→      }\n    97→\n    98→      setUsernameStatus(\"checking\");\n    99→\n   100→      try {\n   101→        const { data, error } = await supabase\n   102→          .from(\"profiles\")\n   103→          .select(\"full_name\")\n   104→          .ilike(\"full_name\", username)\n   105→          .maybeSingle();\n   106→\n   107→        if (error) {\n   108→          // Table might not exist yet, treat as available\n   109→          setUsernameStatus(\"available\");\n   110→          return;\n   111→        }\n   112→\n   113→        if (data) {\n   114→          setUsernameStatus(\"taken\");\n   115→          form.setError(\"username\", {\n   116→            type: \"manual\",\n   117→            message: t(\"errors.usernameTaken\"),\n   118→          });\n   119→        } else {\n   120→          setUsernameStatus(\"available\");\n   121→          form.clearErrors(\"username\");\n   122→        }\n   123→      } catch {\n   124→        // On network error, allow form submission (server will validate)\n   125→        setUsernameStatus(\"available\");\n   126→      }\n   127→    },\n   128→    [form, t]\n   129→  );\n   130→\n   131→  // Debounced username check\n   132→  useEffect(() => {\n   133→    const timeoutId = setTimeout(() => {\n   134→      if (usernameValue && usernameValue.length >= 2) {\n   135→        checkUsernameAvailability(usernameValue);\n   136→      } else {\n   137→        setUsernameStatus(\"idle\");\n   138→      }\n   139→    }, 500);\n   140→\n   141→    return () => clearTimeout(timeoutId);\n   142→  }, [usernameValue, checkUsernameAvailability]);\n   143→\n   144→  const onSubmit = async (values: UsernameFormValues) => {\n   145→    setIsSubmitting(true);\n   146→    setSubmitError(null);\n   147→\n   148→    try {\n   149→      // Final check for username availability\n   150→      if (usernameStatus === \"taken\") {\n   151→        setSubmitError(t(\"errors.usernameTaken\"));\n   152→        setIsSubmitting(false);\n   153→        return;\n   154→      }\n   155→\n   156→      const { data: { user } } = await supabase.auth.getUser();\n   157→\n   158→      if (!user) {\n   159→        setSubmitError(t(\"errors.notAuthenticated\"));\n   160→        setIsSubmitting(false);\n   161→        return;\n   162→      }\n   163→\n   164→      // Update the user's profile with the username\n   165→      const { error: updateError } = await supabase\n   166→        .from(\"profiles\")\n   167→        .upsert({\n   168→          id: user.id,\n   169→          full_name: values.username,\n   170→          email: user.email,\n   171→        });\n   172→\n   173→      if (updateError) {\n   174→        if (updateError.message.includes(\"duplicate\") || updateError.message.includes(\"unique\")) {\n   175→          setSubmitError(t(\"errors.usernameTaken\"));\n   176→        } else {\n   177→          setSubmitError(updateError.message || t(\"errors.genericError\"));\n   178→        }\n   179→        return;\n   180→      }\n   181→\n   182→      // Also update user metadata\n   183→      await supabase.auth.updateUser({\n   184→        data: { full_name: values.username }\n   185→      });\n   186→\n   187→      // Success - redirect to home\n   188→      router.push(`/${locale}`);\n   189→    } catch {\n   190→      setSubmitError(t(\"errors.genericError\"));\n   191→    } finally {\n   192→      setIsSubmitting(false);\n   193→    }\n   194→  };\n   195→\n   196→  const getUsernameStatusIcon = () => {\n   197→    switch (usernameStatus) {\n   198→      case \"checking\":\n   199→        return <Loader2 className=\"h-4 w-4 animate-spin text-muted-foreground\" />;\n   200→      case \"available\":\n   201→        return <CheckCircle className=\"h-4 w-4 text-green-500\" />;\n   202→      case \"taken\":\n   203→        return <XCircle className=\"h-4 w-4 text-destructive\" />;\n   204→      default:\n   205→        return null;\n   206→    }\n   207→  };\n   208→\n   209→  const getUsernameStatusText = () => {\n   210→    switch (usernameStatus) {\n   211→      case \"checking\":\n   212→        return t(\"errors.usernameChecking\");\n   213→      case \"available\":\n   214→        return t(\"errors.usernameAvailable\");\n   215→      case \"taken\":\n   216→        return t(\"errors.usernameTaken\");\n   217→      default:\n   218→        return t(\"usernameDescription\");\n   219→    }\n   220→  };\n   221→\n   222→  if (isLoading) {\n   223→    return (\n   224→      <div className=\"flex min-h-[calc(100vh-8rem)] items-center justify-center\">\n   225→        <Loader2 className=\"h-8 w-8 animate-spin text-muted-foreground\" />\n   226→      </div>\n   227→    );\n   228→  }\n   229→\n   230→  return (\n   231→    <div className=\"flex min-h-[calc(100vh-8rem)] items-center justify-center px-4 py-12\">\n   232→      <div className=\"w-full max-w-md space-y-8\">\n   233→        <div className=\"text-center\">\n   234→          <h1 className=\"text-3xl font-bold tracking-tight\">{t(\"title\")}</h1>\n   235→          <p className=\"mt-2 text-muted-foreground\">{t(\"subtitle\")}</p>\n   236→          {userEmail && (\n   237→            <p className=\"mt-1 text-sm text-muted-foreground\">\n   238→              {t(\"signedInAs\")} <span className=\"font-medium\">{userEmail}</span>\n   239→            </p>\n   240→          )}\n   241→        </div>\n   242→\n   243→        <div className=\"rounded-lg border bg-card p-6 shadow-sm\">\n   244→          <Form {...form}>\n   245→            <form onSubmit={form.handleSubmit(onSubmit)} className=\"space-y-6\">\n   246→              <FormField\n   247→                control={form.control}\n   248→                name=\"username\"\n   249→                render={({ field }) => (\n   250→                  <FormItem>\n   251→                    <FormLabel>{t(\"username\")}</FormLabel>\n   252→                    <FormControl>\n   253→                      <div className=\"relative\">\n   254→                        <Input\n   255→                          placeholder={t(\"usernamePlaceholder\")}\n   256→                          {...field}\n   257→                          className={cn(\n   258→                            usernameStatus === \"taken\" && \"border-destructive\",\n   259→                            usernameStatus === \"available\" && \"border-green-500\"\n   260→                          )}\n   261→                        />\n   262→                        <div className=\"absolute right-3 top-1/2 -translate-y-1/2\">\n   263→                          {getUsernameStatusIcon()}\n   264→                        </div>\n   265→                      </div>\n   266→                    </FormControl>\n   267→                    <FormDescription\n   268→                      className={cn(\n   269→                        usernameStatus === \"taken\" && \"text-destructive\",\n   270→                        usernameStatus === \"available\" && \"text-green-500\"\n   271→                      )}\n   272→                    >\n   273→                      {getUsernameStatusText()}\n   274→                    </FormDescription>\n   275→                    <FormMessage />\n   276→                  </FormItem>\n   277→                )}\n   278→              />\n   279→\n   280→              {submitError && (\n   281→                <div className=\"rounded-md bg-destructive/10 p-3 text-sm text-destructive\">\n   282→                  {submitError}\n   283→                </div>\n   284→              )}\n   285→\n   286→              <Button\n   287→                type=\"submit\"\n   288→                className=\"w-full\"\n   289→                disabled={isSubmitting || usernameStatus === \"taken\" || usernameStatus === \"checking\"}\n   290→              >\n   291→                {isSubmitting ? (\n   292→                  <>\n   293→                    <Loader2 className=\"mr-2 h-4 w-4 animate-spin\" />\n   294→                    {t(\"submitting\")}\n   295→                  </>\n   296→                ) : (\n   297→                  t(\"submit\")\n   298→                )}\n   299→              </Button>\n   300→            </form>\n   301→          </Form>\n   302→        </div>\n   303→      </div>\n   304→    </div>\n   305→  );\n   306→}\n   307→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":"toolu_01KtuiUVNNMHPKNssgRXtHCS","session_id":"dd558466-241e-4005-8014-18e5732e4b3e","uuid":"7fdf0dee-1401-49ce-bd6a-62a3d5e2ca09"}
