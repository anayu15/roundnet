+      paymentReference: body.paymentReference,","     });","+    console.log(\"To enable email notifications, install nodemailer: npm install nodemailer\");"," ","-    const paymentMethodLabel =","-      body.paymentMethod === \"bizum\" ? \"Bizum\" : \"Transferencia bancaria\";","-","-    const emailHtml = `","-      <h2>Nueva solicitud de membresía AMR</h2>","-      <p>Se ha recibido una nueva solicitud de membresía.</p>","-      <table style=\"border-collapse: collapse; margin: 20px 0;\">","-        <tr>","-          <td style=\"padding: 8px; border: 1px solid #ddd; font-weight: bold;\">ID de Membresía</td>","-          <td style=\"padding: 8px; border: 1px solid #ddd;\">${body.membershipId}</td>","-        </tr>","-        <tr>","-          <td style=\"padding: 8px; border: 1px solid #ddd; font-weight: bold;\">Método de Pago</td>","-          <td style=\"padding: 8px; border: 1px solid #ddd;\">${paymentMethodLabel}</td>","-        </tr>","-        <tr>","-          <td style=\"padding: 8px; border: 1px solid #ddd; font-weight: bold;\">Referencia de Pago</td>","-          <td style=\"padding: 8px; border: 1px solid #ddd;\">${body.paymentReference}</td>","-        </tr>","-      </table>","-      <p>Por favor, verifica el pago y aprueba la solicitud desde el panel de administración.</p>","-    `;","-","-    const emailText = `","-Nueva solicitud de membresía AMR","-","-Se ha recibido una nueva solicitud de membresía.","-","-ID de Membresía: ${body.membershipId}","-Método de Pago: ${paymentMethodLabel}","-Referencia de Pago: ${body.paymentReference}","-","-Por favor, verifica el pago y aprueba la solicitud desde el panel de administración.","-    `;","-","-    await transporter.sendMail({","-      from: SMTP_FROM || SMTP_USER,","-      to: ADMIN_EMAIL,","-      subject: \"Nueva solicitud de membresía AMR\",","-      text: emailText,","-      html: emailHtml,","-    });","-","     return NextResponse.json({","       success: true,","-      message: \"Admin notification sent\",","+      message: \"Application logged - install nodemailer to enable email notifications\",","     });","   } catch (error) {","-    console.error(\"Error sending admin notification:\", error);","+    console.error(\"Error processing admin notification:\", error);","     // Don't fail the request - email notification is optional","     return NextResponse.json({","       success: true,","-      message: \"Email notification failed but application was processed\",","+      message: \"Notification processing completed\",","     });","   }"," }"]}],"originalFile":"import { NextResponse } from \"next/server\";\n\n// Admin email notification endpoint\n// This endpoint sends an email notification to admins when a new membership application is submitted\n// Email sending is optional - if not configured, the endpoint will silently succeed\n\nconst ADMIN_EMAIL = process.env.ADMIN_EMAIL;\nconst SMTP_HOST = process.env.SMTP_HOST;\nconst SMTP_PORT = process.env.SMTP_PORT;\nconst SMTP_USER = process.env.SMTP_USER;\nconst SMTP_PASS = process.env.SMTP_PASS;\nconst SMTP_FROM = process.env.SMTP_FROM;\n\ntype NotifyAdminRequest = {\n  membershipId: string;\n  paymentReference: string;\n  paymentMethod: \"bizum\" | \"transfer\";\n};\n\nexport async function POST(request: Request) {\n  try {\n    const body: NotifyAdminRequest = await request.json();\n\n    // Check if email is configured\n    if (!ADMIN_EMAIL || !SMTP_HOST || !SMTP_USER || !SMTP_PASS) {\n      // Email not configured - silently succeed\n      return NextResponse.json({\n        success: true,\n        message: \"Email notification skipped - email not configured\",\n      });\n    }\n\n    // Import nodemailer dynamically only if email is configured\n    // This allows the app to work without nodemailer installed\n    let nodemailer;\n    try {\n      nodemailer = await import(\"nodemailer\");\n    } catch {\n      return NextResponse.json({\n        success: true,\n        message: \"Email notification skipped - nodemailer not installed\",\n      });\n    }\n\n    const transporter = nodemailer.createTransport({\n      host: SMTP_HOST,\n      port: parseInt(SMTP_PORT || \"587\"),\n      secure: SMTP_PORT === \"465\",\n      auth: {\n        user: SMTP_USER,\n        pass: SMTP_PASS,\n      },\n    });\n\n    const paymentMethodLabel =\n      body.paymentMethod === \"bizum\" ? \"Bizum\" : \"Transferencia bancaria\";\n\n    const emailHtml = `\n      <h2>Nueva solicitud de membresía AMR</h2>\n      <p>Se ha recibido una nueva solicitud de membresía.</p>\n      <table style=\"border-collapse: collapse; margin: 20px 0;\">\n        <tr>\n          <td style=\"padding: 8px; border: 1px solid #ddd; font-weight: bold;\">ID de Membresía</td>\n          <td style=\"padding: 8px; border: 1px solid #ddd;\">${body.membershipId}</td>\n        </tr>\n        <tr>\n          <td style=\"padding: 8px; border: 1px solid #ddd; font-weight: bold;\">Método de Pago</td>\n          <td style=\"padding: 8px; border: 1px solid #ddd;\">${paymentMethodLabel}</td>\n        </tr>\n        <tr>\n          <td style=\"padding: 8px; border: 1px solid #ddd; font-weight: bold;\">Referencia de Pago</td>\n          <td style=\"padding: 8px; border: 1px solid #ddd;\">${body.paymentReference}</td>\n        </tr>\n      </table>\n      <p>Por favor, verifica el pago y aprueba la solicitud desde el panel de administración.</p>\n    `;\n\n    const emailText = `\nNueva solicitud de membresía AMR\n\nSe ha recibido una nueva solicitud de membresía.\n\nID de Membresía: ${body.membershipId}\nMétodo de Pago: ${paymentMethodLabel}\nReferencia de Pago: ${body.paymentReference}\n\nPor favor, verifica el pago y aprueba la solicitud desde el panel de administración.\n    `;\n\n    await transporter.sendMail({\n      from: SMTP_FROM || SMTP_USER,\n      to: ADMIN_EMAIL,\n      subject: \"Nueva solicitud de membresía AMR\",\n      text: emailText,\n      html: emailHtml,\n    });\n\n    return NextResponse.json({\n      success: true,\n      message: \"Admin notification sent\",\n    });\n  } catch (error) {\n    console.error(\"Error sending admin notification:\", error);\n    // Don't fail the request - email notification is optional\n    return NextResponse.json({\n      success: true,\n      message: \"Email notification failed but application was processed\",\n    });\n  }\n}\n"}}
